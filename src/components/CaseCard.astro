---
import PlaceholderImage from "./PlaceholderImage.astro";
import type { WorkCase } from "../data/work";

interface Props {
  work: WorkCase;
}
const { work } = Astro.props;
---

<a class="card" href={`/work/${work.slug}`}>
  <PlaceholderImage ratio="4/3" label={work.category} />
  <div class="card-body">
    <span class="tag">{work.category}</span>
    <h3>{work.title}</h3>
    {work.subtitle && <p class="subtitle">{work.subtitle}</p>}
  </div>
  <span class="arrow" aria-hidden="true">&rarr;</span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    position: relative;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-right: 28px;
  }

  .card h3 {
    font-size: 19px;
    line-height: 1.3;
  }

  .subtitle {
    font-size: 14px;
    color: var(--color-ink-soft);
  }

  .arrow {
    position: absolute;
    top: 0;
    right: 0;
    font-size: 18px;
    color: var(--color-ink-faint);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .card:hover .arrow {
    transform: translate(3px, -3px);
    color: var(--color-accent);
  }
</style>
