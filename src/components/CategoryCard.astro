---
import { Image } from "astro:assets";
import type { CategoryCard } from "../data/categories";

interface Props {
  card: CategoryCard;
}
const { card } = Astro.props;
---

<a class="cat-card" href={card.href}>
  <Image
    src={card.image}
    alt={card.imageAlt}
    widths={[400, 600, 800, 1000]}
    sizes="(max-width: 900px) 90vw, 380px"
    class="cat-card-img"
  />
  <div class="cat-card-panel">
    <p class="cat-card-tag">{card.label}</p>
    <div class="cat-card-text">
      <p class="cat-card-rest">{card.restDescription}</p>
      <p class="cat-card-hover">{card.hoverTitle}</p>
    </div>
    <span class="btn btn--outline cat-card-cta">
      {card.buttonLabel}
      <span class="arrow" aria-hidden="true">&rarr;</span>
    </span>
  </div>
</a>

<style>
  .cat-card {
    position: relative;
    display: block;
    flex: 1 1 0%;
    min-width: 0;
    border-radius: 28px;
    overflow: hidden;
    transition: flex-grow 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Group-hover accordion: hovering one card widens it and squeezes
     its siblings, which fade their own text out. .category-grid lives
     in the parent page, hence :global() on just that token — :has()
     and the rest stay scoped normally since .cat-card/.cat-card-panel
     are this component's own classes. */
  :global(.category-grid):has(.cat-card:hover) .cat-card {
    flex-grow: 0.62;
  }

  :global(.category-grid):has(.cat-card:hover) .cat-card:hover {
    flex-grow: 1.8;
  }

  :global(.category-grid):has(.cat-card:hover)
    .cat-card:not(:hover)
    .cat-card-panel {
    opacity: 0;
    pointer-events: none;
  }

  .cat-card :global(.cat-card-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cat-card-panel {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 26px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.62),
      rgba(0, 0, 0, 0) 65%
    );
    color: #fff;
    transition: background 0.45s ease, color 0.45s ease, opacity 0.35s ease;
  }

  /* The "liquid glass" hover state: frosted, translucent, blurred. */
  .cat-card:hover .cat-card-panel,
  .cat-card:focus-visible .cat-card-panel {
    background: rgba(255, 255, 255, 0.62);
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    color: var(--color-ink);
  }

  .cat-card-tag {
    margin: 0;
    font-style: italic;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .cat-card-text {
    position: relative;
    width: 100%;
    min-height: 2.9em;
  }

  .cat-card-rest,
  .cat-card-hover {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .cat-card-rest {
    opacity: 1;
  }

  .cat-card-hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(6px);
    font-weight: 600;
  }

  .cat-card:hover .cat-card-rest,
  .cat-card:focus-visible .cat-card-rest {
    opacity: 0;
  }

  .cat-card:hover .cat-card-hover,
  .cat-card:focus-visible .cat-card-hover {
    opacity: 1;
    transform: translateY(0);
  }

  .cat-card-cta {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .cat-card:hover .cat-card-cta,
  .cat-card:focus-visible .cat-card-cta {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-card,
    .cat-card-panel,
    .cat-card-rest,
    .cat-card-hover,
    .cat-card-cta {
      transition: none;
    }
  }

  /* The parent grid drops to a column stack below 900px (no room
     for the accordion effect, and no real hover on touch anyway) —
     each card needs its own height back since the row's fixed
     height no longer applies. */
  @media (max-width: 900px) {
    .cat-card {
      aspect-ratio: 4 / 5;
    }
  }
</style>
