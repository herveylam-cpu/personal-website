---
// Wraps a 9:19-ish screen (a PlaceholderImage or real screenshot,
// passed as the default slot) with the actual iPhone mockup photo
// at /images/phone-frame.png — its screen interior was knocked out
// to transparent so the slot content shows through. Only the
// Dynamic Island + camera dot are redrawn in CSS on top, since the
// source photo's island was removed along with the rest of the
// black screen fill.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class:list={["phone-frame", className]}>
  <div class="phone-frame-screen">
    <slot />
  </div>
  <img class="phone-frame-img" src="/images/phone-frame.png" alt="" aria-hidden="true" />
  <span class="phone-frame-island" aria-hidden="true">
    <span class="phone-frame-camera" aria-hidden="true"></span>
  </span>
</div>

<style>
  .phone-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 490 / 1005;
  }

  .phone-frame-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    user-select: none;
  }

  .phone-frame-screen {
    position: absolute;
    top: 1%;
    bottom: 1.1%;
    left: 2.9%;
    right: 3.1%;
    border-radius: 13%;
    overflow: hidden;
    background: var(--color-bg);
  }

  .phone-frame-screen :global(.ph) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none !important;
    border-radius: 0 !important;
  }

  .phone-frame-screen :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phone-frame-island {
    position: absolute;
    top: 3.2%;
    left: 50%;
    transform: translateX(-50%);
    width: 34%;
    height: 3.1%;
    background: #0b0b0c;
    border-radius: 100px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 8%;
  }

  .phone-frame-camera {
    width: 32%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #3a4a6b, #0b0b0c 70%);
  }
</style>
