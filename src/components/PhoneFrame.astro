---
// A titanium-style iPhone device frame (modeled on the iPhone
// 15/16 Pro): metallic bezel, side buttons, and a Dynamic Island
// with a camera dot. Wraps a 9:19.5 screen (a PlaceholderImage or
// real screenshot) passed as the default slot, which is stretched
// to fill the screen area regardless of its own sizing/radius props.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class:list={["phone-frame", className]}>
  <span class="phone-frame-btn phone-frame-btn--action" aria-hidden="true"></span>
  <span class="phone-frame-btn phone-frame-btn--vol-up" aria-hidden="true"></span>
  <span class="phone-frame-btn phone-frame-btn--vol-down" aria-hidden="true"></span>
  <span class="phone-frame-btn phone-frame-btn--power" aria-hidden="true"></span>
  <div class="phone-frame-screen">
    <slot />
    <span class="phone-frame-island" aria-hidden="true">
      <span class="phone-frame-camera" aria-hidden="true"></span>
    </span>
  </div>
</div>

<style>
  .phone-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 19.5;
    box-sizing: border-box;
    background: linear-gradient(145deg, #efece3 0%, #cfc9b8 28%, #e2ddd0 52%, #b6b0a0 100%);
    border-radius: 21%;
    padding: 2.6%;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.5),
      inset 0 0 2px 2px rgba(23, 20, 15, 0.18),
      0 16px 32px rgba(23, 20, 15, 0.18);
  }

  .phone-frame-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 18%;
    overflow: hidden;
    background: var(--color-bg);
  }

  .phone-frame-screen :global(.ph) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none !important;
    border-radius: 0 !important;
  }

  .phone-frame-screen :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phone-frame-island {
    position: absolute;
    top: 3.2%;
    left: 50%;
    transform: translateX(-50%);
    width: 34%;
    height: 3.1%;
    background: #0b0b0c;
    border-radius: 100px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 8%;
  }

  .phone-frame-camera {
    width: 32%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #3a4a6b, #0b0b0c 70%);
  }

  /* Physical buttons, flush with the flat sides of the frame —
     percentages are relative to the frame's own box, so they scale
     with it from the 4-up compact rows up to the single hero shots. */
  .phone-frame-btn {
    position: absolute;
    background: linear-gradient(90deg, #cfc9b8, #a39d8d);
    z-index: 1;
  }

  .phone-frame-btn--action {
    top: 16%;
    left: -1.2%;
    width: 1.2%;
    height: 3.2%;
    border-radius: 2px 0 0 2px;
  }

  .phone-frame-btn--vol-up {
    top: 23%;
    left: -1.2%;
    width: 1.2%;
    height: 6%;
    border-radius: 2px 0 0 2px;
  }

  .phone-frame-btn--vol-down {
    top: 31%;
    left: -1.2%;
    width: 1.2%;
    height: 6%;
    border-radius: 2px 0 0 2px;
  }

  .phone-frame-btn--power {
    top: 24%;
    right: -1.2%;
    width: 1.2%;
    height: 8%;
    border-radius: 0 2px 2px 0;
  }
</style>
