---
interface Props {
  label?: string;
  ratio?: string; // e.g. "16/9", "4/3", "1/1"
  radius?: string; // e.g. "4px", "40px"
  class?: string;
}
const {
  label = "Image placeholder",
  ratio = "4/3",
  radius = "4px",
  class: className = "",
} = Astro.props;
---

<div
  class:list={["ph", className]}
  style={`aspect-ratio: ${ratio}; border-radius: ${radius};`}
>
  <span class="ph-label">{label}</span>
</div>

<style>
  .ph {
    width: 100%;
    background: repeating-linear-gradient(
      135deg,
      rgba(23, 20, 15, 0.06) 0px,
      rgba(23, 20, 15, 0.06) 1px,
      transparent 1px,
      transparent 10px
    );
    background-color: rgba(23, 20, 15, 0.035);
    border: 1px solid var(--color-line);
    display: flex;
    align-items: flex-end;
    padding: 10px;
  }

  .ph-label {
    font-style: italic;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
    background: var(--color-bg);
    padding: 3px 8px;
    border-radius: 100px;
  }
</style>
