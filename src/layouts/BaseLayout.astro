---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Lin Hongyu — Monee Design Head.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!--
      Site-wide noindex for now: content isn't ready to be public yet.
      Remove this (and the matching robots.txt disallow) once the site
      is ready to launch. A password gate goes in at deploy time via
      Vercel Edge Middleware, not here.
    -->
    <meta name="robots" content="noindex, nofollow" />

    <!--
      No webfont links: the whole site runs on the system UI font
      (San Francisco on Apple devices), so there's nothing to load —
      also faster than any webfont.
    -->
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
