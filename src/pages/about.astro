---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";
import { experience } from "../data/experience";
---

<BaseLayout
  title="About — Lin Hongyu"
  description="Head of Design at Monee — background, focus areas, and work experience."
>
  <!-- Module 1: identity -->
  <section class="section intro">
    <div class="wrap intro-grid">
      <PlaceholderImage
        ratio="3/4"
        radius="32px"
        label="Personal photo"
        class="intro-photo"
      />
      <div class="intro-copy">
        <h1 class="intro-name">Lin Hongyu</h1>
        <p class="eyebrow intro-role">Head of Design</p>
        <p class="intro-body">
          Monee is the fintech sub-group of SEA Limited (NYSE: SE),
          Singapore's tech giant. As Head of Design, I oversee brand,
          product, and operations design across everything Monee —
          one corporate brand, Monee Corporate, and five core
          business lines: Digital Bank, Payment, Loan, Investment,
          and Insurance — spanning both B2B and B2C products.
        </p>
      </div>
    </div>
  </section>

  <!-- Module 2: experience — title/subtitle, then a scroll-driven
       two-column list (left: photo per company, right: company names
       that expand into role detail as each becomes active) -->
  <section class="section exp-intro">
    <div class="wrap">
      <h2 class="exp-title">
        Over <span class="exp-counter" data-target="12">0</span> years
        of design experience
      </h2>
      <p class="exp-subtitle">
        including leading multiple 0-to-1 end-to-end product launches
      </p>
    </div>
  </section>

  <section class="exp-stage" style={`--exp-steps: ${experience.length}`}>
    <div class="wrap">
      <div class="exp-pin">
        <div class="exp-media">
          {
            experience.map((company) => (
              <PlaceholderImage
                ratio="4/5"
                radius="24px"
                label={`${company.name} photo`}
                class="exp-media-img"
              />
            ))
          }
        </div>
        <div class="exp-list">
          {
            experience.map((company) => (
              <div class="exp-item">
                <p class="exp-item-name">{company.name}</p>
                <div class="exp-item-detail">
                  <div class="exp-item-detail-inner">
                    <p class="exp-item-meta">{company.location}</p>
                    {company.roles.map((role) => (
                      <div class="exp-role">
                        <div class="exp-role-head">
                          <p class="exp-role-title">{role.title}</p>
                          <p class="exp-role-date">
                            {role.dateRange}
                            {role.tag ? ` · ${role.tag}` : ""}
                          </p>
                        </div>
                        <p class="exp-role-desc">{role.description}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Module 3 (to be redesigned): the old summary cards + note,
       kept below for now per the current plan -->
  <section class="section role">
    <div class="wrap">
      <div class="focus-grid">
        <div class="focus-card">
          <p class="focus-tag">Design Quality</p>
          <p>
            Focus on business growth and user experience — define
            design strategy and safeguard the quality of design
            output.
          </p>
        </div>
        <div class="focus-card">
          <p class="focus-tag">Efficiency</p>
          <p>
            Connect and align resources to improve collaboration
            efficiency, both within the team and across it.
          </p>
        </div>
        <div class="focus-card">
          <p class="focus-tag">Capability Growth</p>
          <p>
            Lead the evolution of the design team's craft and role
            elevation — building and evolving the talent matrix.
          </p>
        </div>
      </div>

      <p class="focus-note">
        I'd define myself and my team as <em>Business Designers</em>,
        not <em>Product Designers</em> — we design strategy from a
        business point of view. Business growth is the goal; user
        experience and product strategy are how we get there, so
        every project seeks solutions where UX balances and empowers
        business needs.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Module 1: identity */
  .intro {
    padding-top: var(--space-6);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(240px, 340px) 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  .intro-name {
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05;
    margin: 0 0 var(--space-2);
  }

  .intro-role {
    margin: 0 0 var(--space-3);
  }

  .intro-body {
    max-width: 560px;
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.65;
    color: var(--color-ink-soft);
  }

  /* Module 2: experience title/subtitle */
  .exp-intro {
    text-align: center;
    padding-bottom: var(--space-4);
  }

  /* Entrance animation for the module — triggered by scroll position
     (see the script below), not on page load: this section is below
     the fold for most people, and a load-time animation finishes
     long before anyone has scrolled down far enough to see it.
     Scoped to .exp-intro only, not .exp-stage: a transform on an
     ancestor of .exp-pin can interfere with its sticky positioning,
     and .exp-stage already has its own reveal via the photo stack. */
  @media (prefers-reduced-motion: no-preference) {
    .exp-intro {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }

    .exp-intro.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .exp-title {
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: clamp(40px, 7vw, 72px);
    line-height: 1.1;
    margin: 0 0 var(--space-3);
  }

  .exp-counter {
    font-variant-numeric: tabular-nums;
  }

  .exp-subtitle {
    font-size: clamp(17px, 2vw, 20px);
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* Module 2: experience scroll-stage. .exp-stage gives extra scroll
     room (one "step" per company) for the reveal; .exp-pin is what
     stays stuck to the viewport while that room scrolls past. 35vh
     turned out too twitchy (a tiny nudge already flipped company);
     60vh is a middle ground between that and the original 90vh. */
  .exp-stage {
    position: relative;
    height: calc(var(--exp-steps, 3) * 60vh);
  }

  /* .exp-pin's sticky containing block is .wrap (its direct parent),
     not .exp-stage — .wrap has no height of its own, so without this
     it just shrinks to .exp-pin's height, leaving zero room to
     stick. height: 100% pulls the full .exp-stage height through. */
  .exp-stage > .wrap {
    height: 100%;
  }

  .exp-pin {
    position: sticky;
    top: 96px;
    height: min(78vh, 640px);
    display: grid;
    grid-template-columns: minmax(220px, 340px) 1fr;
    gap: var(--space-6);
    align-items: center;
    padding-block: var(--space-4);
  }

  .exp-media {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 24px;
  }

  /* Each photo (after the first) sits translated fully below the
     frame until its turn, then slides up to translateY(0) and stays
     there, stacking on top of whichever one came before it — see the
     per-image z-index below and the transform math in the script.
     No transition here on purpose: this transform is set on every
     scroll event to directly track scroll position, like a scrubber.
     A CSS transition would make it perpetually ease toward a moving
     target instead of matching the actual scroll position, which is
     exactly what made it feel out of sync with the text. */
  .exp-media :global(.exp-media-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: translateY(100%);
  }

  .exp-media :global(.exp-media-img:first-child) {
    transform: translateY(0);
  }

  .exp-media :global(.exp-media-img:nth-child(1)) {
    z-index: 1;
  }
  .exp-media :global(.exp-media-img:nth-child(2)) {
    z-index: 2;
  }
  .exp-media :global(.exp-media-img:nth-child(3)) {
    z-index: 3;
  }
  .exp-media :global(.exp-media-img:nth-child(4)) {
    z-index: 4;
  }

  .exp-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .exp-item {
    padding-block: var(--space-2);
    border-top: 1px solid var(--color-line);
  }

  .exp-item:first-child {
    border-top: none;
  }

  .exp-item-name {
    margin: 0;
    font-weight: 700;
    font-size: clamp(20px, 2.6vw, 28px);
    color: var(--color-ink-faint);
    transition: color 0.4s ease;
  }

  .exp-item.is-active .exp-item-name {
    color: var(--color-ink);
  }

  .exp-item-detail {
    display: grid;
    /* minmax(0, 0fr), not bare 0fr — a bare 0fr track still respects
       the implicit auto/min-content floor and never actually
       collapses; wrapping in minmax(0, …) overrides that floor. */
    grid-template-rows: minmax(0, 0fr);
    opacity: 0;
    transition: grid-template-rows 0.5s ease, opacity 0.4s ease;
  }

  .exp-item.is-active .exp-item-detail {
    grid-template-rows: minmax(0, 1fr);
    opacity: 1;
  }

  .exp-item-detail-inner {
    overflow: hidden;
  }

  .exp-item-meta {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--color-ink-faint);
  }

  .exp-role {
    margin-top: var(--space-3);
  }

  .exp-role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .exp-role-title {
    margin: 0;
    font-weight: 600;
    font-size: 15px;
  }

  .exp-role-date {
    margin: 0;
    font-size: 13px;
    color: var(--color-ink-faint);
    white-space: nowrap;
  }

  .exp-role-desc {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* Module 3 (to be redesigned): kept for now */
  .role {
    text-align: center;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .focus-card {
    text-align: left;
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: 16px;
  }

  .focus-tag {
    font-weight: 700;
    font-size: 17px;
    margin: 0 0 10px;
  }

  .focus-card p + p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* Sub-text level — a supplementary note under the focus cards, not
     a big statement like Home's philosophy pull-quote. */
  .focus-note {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink-faint);
    max-width: 640px;
    margin-inline: auto;
  }

  .focus-note em {
    font-style: italic;
    color: var(--color-accent);
  }

  @media (max-width: 800px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }

    .intro-photo {
      max-width: 320px;
      margin-inline: auto;
    }

    .focus-grid {
      grid-template-columns: 1fr;
    }

    /* No room for a 2-column sticky scroll effect here, and no real
       scroll-driven "reveal" reason to keep it on a touch device —
       drop straight to a plain, fully expanded list. */
    .exp-stage {
      height: auto;
    }

    .exp-pin {
      position: static;
      height: auto;
      display: block;
    }

    .exp-media {
      display: none;
    }

    .exp-item-detail,
    .exp-item.is-active .exp-item-detail {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }
</style>

<script>
  // Scroll-driven "which company is active" for the experience
  // section: as the user scrolls through .exp-stage's extra height,
  // each company's name/photo becomes active in turn while .exp-pin
  // stays stuck. Same technique as the Home hero reveal — a plain
  // scroll listener recomputing state each event, no rAF (trivial
  // per-event cost, and rAF can stay starved in backgrounded tabs).
  function setupExperienceScroll() {
    const stage = document.querySelector<HTMLElement>(".exp-stage");
    const pin = document.querySelector<HTMLElement>(".exp-pin");
    const items = document.querySelectorAll<HTMLElement>(".exp-item");
    const images = document.querySelectorAll<HTMLElement>(".exp-media-img");
    if (!stage || !pin || items.length === 0) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion) {
      // Skip the scroll-driven step-through; show every company
      // expanded at once, with no extra scroll room needed. The photo
      // stack has no story to tell without the scroll-linked motion,
      // so hide that column entirely (same call as the mobile
      // fallback below 800px).
      stage.style.height = "auto";
      pin.style.position = "static";
      pin.style.height = "auto";
      const media = document.querySelector<HTMLElement>(".exp-media");
      if (media) media.style.display = "none";
      items.forEach((item) => item.classList.add("is-active"));
      return;
    }

    const count = items.length;

    function update() {
      const rect = stage!.getBoundingClientRect();
      const scrollRange = Math.max(1, stage!.offsetHeight - pin!.offsetHeight);
      const progress = Math.min(1, Math.max(0, -rect.top / scrollRange));
      const raw = progress * count; // continuous, 0..count
      const activeIndex = Math.min(count - 1, Math.floor(raw));

      items.forEach((item, i) => {
        item.classList.toggle("is-active", i === activeIndex);
      });
      // Each photo (after the first) slides up from below and stacks
      // on top of the previous one, staying put (fully covering) once
      // revealed — later photos then stack on top of it in turn.
      // Image 0 has nothing before it, so it's just always in place.
      // Whichever photo is underneath shrinks away in lockstep with
      // the next one sliding up, so it's fully gone (scale 0) at the
      // exact moment the new one fully covers.
      //
      // The slide only happens in the last WINDOW fraction of each
      // company's step, finishing right as the text flips to the
      // next company (at each whole-number boundary of `raw`) — not
      // spread across the whole step. Otherwise the photo would
      // already be mid-transition (or fully switched) while the text
      // still shows the previous company as active, which read as the
      // two being out of sync with each other.
      const WINDOW = 0.4;
      function stepProgress(boundary: number) {
        return Math.max(0, Math.min(1, (raw - (boundary - WINDOW)) / WINDOW));
      }
      images.forEach((img, i) => {
        const reveal = i === 0 ? 1 : stepProgress(i);
        const nextReveal = i < count - 1 ? stepProgress(i + 1) : 0;
        const scale = 1 - nextReveal;
        img.style.transform = `translateY(${(1 - reveal) * 100}%) scale(${scale})`;
      });
    }

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  setupExperienceScroll();

  // Reveal .exp-intro (fade + lift) and count its number up 0->target
  // the first time it scrolls into view. Driven by a plain scroll
  // listener + getBoundingClientRect, same technique as the company
  // switcher above (not IntersectionObserver) — this only needs to
  // fire once, so it unregisters itself after triggering.
  function setupExpIntroReveal() {
    const intro = document.querySelector<HTMLElement>(".exp-intro");
    const counter = document.querySelector<HTMLElement>(".exp-counter");
    if (!intro) return;

    const target = Number(counter?.dataset.target ?? "0");
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion) {
      intro.classList.add("is-visible");
      if (counter) counter.textContent = String(target);
      return;
    }

    function runCounter() {
      if (!counter) return;
      const duration = 700;
      const start = performance.now();
      function tick(now: number) {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
        counter.textContent = String(Math.round(eased * target));
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    function check() {
      const rect = intro.getBoundingClientRect();
      // Trigger once the section is meaningfully on screen, not just
      // a sliver of it peeking in at the very edge.
      if (rect.top < window.innerHeight * 0.85 && rect.bottom > 0) {
        intro.classList.add("is-visible");
        runCounter();
        window.removeEventListener("scroll", check);
      }
    }

    check(); // covers the case where it's already in view at load
    window.addEventListener("scroll", check, { passive: true });
  }

  setupExpIntroReveal();
</script>
