---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";
import { experience } from "../data/experience";
import companyMonee from "../assets/about/company-monee.png";
import companyJd from "../assets/about/company-jd.png";
import companyTencent from "../assets/about/company-tencent.png";
import portraitPhoto from "../assets/about/portrait.jpg";

const companyImages: Record<string, ImageMetadata> = {
  "SEA / Monee": companyMonee,
  "JD.com": companyJd,
  Tencent: companyTencent,
};
---

<BaseLayout
  title="About — Lin Hongyu"
  description="Head of Design at Monee — background, focus areas, and work experience."
>
  <!-- Module 1: identity -->
  <section class="section intro">
    <div class="wrap intro-grid">
      <Image
        src={portraitPhoto}
        alt="Lin Hongyu"
        widths={[480, 720, 960]}
        sizes="(max-width: 900px) 90vw, 420px"
        class="intro-photo"
      />
      <div class="intro-copy">
        <h1 class="intro-name">Lin Hongyu</h1>
        <p class="eyebrow intro-role">Head of Design</p>
        <p class="intro-body">
          Monee is the fintech sub-group of SEA Limited (NYSE: SE),
          Singapore's tech giant. As Head of Design, I oversee brand,
          product, and operations design across everything Monee —
          one corporate brand, Monee Corporate, and five core
          business lines: Digital Bank, Payment, Loan, Investment,
          and Insurance — spanning both B2B and B2C products.
        </p>
      </div>
    </div>
  </section>

  <!-- Module 2: experience — title/subtitle, then a scroll-driven
       two-column list (left: photo per company, right: company names
       that expand into role detail as each becomes active) -->
  <section class="section exp-intro">
    <div class="wrap">
      <h2 class="exp-title">
        Over <span class="exp-counter" data-target="12">0</span> years
        of design experience
      </h2>
      <p class="exp-subtitle">
        including leading multiple 0-to-1 end-to-end product launches
      </p>
    </div>
  </section>

  <section class="exp-stage" style={`--exp-steps: ${experience.length}`}>
    <div class="wrap">
      <div class="exp-pin">
        <div class="exp-media">
          {
            experience.map((company) =>
              companyImages[company.name] ? (
                <Image
                  src={companyImages[company.name]}
                  alt={company.logoAlt}
                  widths={[320, 480, 640]}
                  sizes="340px"
                  class="exp-media-img"
                />
              ) : (
                <PlaceholderImage
                  ratio="4/5"
                  radius="30px"
                  label={`${company.name} photo`}
                  class="exp-media-img"
                />
              )
            )
          }
        </div>
        <div class="exp-list">
          {
            experience.map((company) => (
              <div class="exp-item">
                <p class="exp-item-name">{company.name}</p>
                <div class="exp-item-detail">
                  <div class="exp-item-detail-inner">
                    <p class="exp-item-meta">{company.location}</p>
                    {company.roles.map((role) => (
                      <div class="exp-role">
                        <div class="exp-role-head">
                          <p class="exp-role-title">{role.title}</p>
                          <p class="exp-role-date">
                            {role.dateRange}
                            {role.tag ? ` · ${role.tag}` : ""}
                          </p>
                        </div>
                        <p class="exp-role-desc">{role.description}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Module 3 -->
  <section class="section focus-intro">
    <div class="wrap">
      <h2 class="focus-title">
        Over <span class="focus-counter" data-target="7">0</span> years
        of design management experience
      </h2>
      <p class="focus-subtitle">
        Experience building a team from zero to one.<br />
        I currently lead a design team of 30+, reporting to the CEO
        and each business line's Business Head.
      </p>

      <div class="focus-grid">
        <div class="focus-card">
          <div class="focus-icon-wrap">
            <PlaceholderImage
              ratio="1/1"
              radius="16px"
              label="Icon"
              class="focus-icon"
            />
          </div>
          <p class="focus-tag">Design Quality</p>
          <p>
            Focus on business growth and user experience — define
            design strategy and safeguard the quality of design
            output.
          </p>
        </div>
        <div class="focus-card">
          <div class="focus-icon-wrap">
            <PlaceholderImage
              ratio="1/1"
              radius="16px"
              label="Icon"
              class="focus-icon"
            />
          </div>
          <p class="focus-tag">Efficiency</p>
          <p>
            Connect and align resources to improve collaboration
            efficiency, both within the team and across it.
          </p>
        </div>
        <div class="focus-card">
          <div class="focus-icon-wrap">
            <PlaceholderImage
              ratio="1/1"
              radius="16px"
              label="Icon"
              class="focus-icon"
            />
          </div>
          <p class="focus-tag">Capability Growth</p>
          <p>
            Lead the evolution of the design team's craft and role
            elevation — building and evolving the talent matrix.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Full-bleed closing statement, echoing Home's "On Design" quote
       treatment but as its own dark banner -->
  <section class="cta-banner">
    <div class="wrap">
      <p class="eyebrow cta-eyebrow">On Design</p>
      <p class="cta-statement">
        I'd define myself and my team as <em>Business Designers</em>,
        not <em>Product Designers</em> — we design strategy from a
        business point of view. Business growth is the goal; user
        experience and product strategy are how we get there, so
        every project seeks solutions where UX balances and empowers
        business needs.
      </p>
      <a class="btn btn--light" href="#" download>
        Download resume <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Module 1: identity */
  .intro {
    padding-top: var(--space-6);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(240px, 340px) 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  /* The photo itself is a plain 1200x1798 portrait, cropped to this
     slot's 3:4 frame (centered) rather than shown at its own ratio —
     unlike the company/card photos, there's no "show it uncropped"
     requirement here. */
  .intro-photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center;
    border-radius: 32px;
    display: block;
  }

  .intro-name {
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05;
    margin: 0 0 var(--space-2);
  }

  .intro-role {
    margin: 0 0 var(--space-3);
  }

  .intro-body {
    max-width: 560px;
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.65;
    color: var(--color-ink-soft);
  }

  /* Module 1 sits above the fold, so it gets a page-load entrance
     (like the Home hero) rather than a scroll-triggered one — there's
     no "scrolling into view" moment to hook for content that's
     already on screen at load. */
  @media (prefers-reduced-motion: no-preference) {
    /* :global() — .intro-photo's actual <div> is rendered inside
       PlaceholderImage.astro's own template/scope, not this file's,
       so a bare selector here never matches it (same issue fixed for
       .cat-card-img/.exp-media-img on other pages). */
    :global(.intro-photo) {
      animation: intro-enter 0.9s cubic-bezier(0.19, 1, 0.22, 1) both;
    }

    .intro-copy {
      animation: intro-enter 0.8s cubic-bezier(0.19, 1, 0.22, 1) 0.15s both;
    }
  }

  @keyframes intro-enter {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Module 2: experience title/subtitle */
  .exp-intro {
    text-align: center;
    padding-bottom: var(--space-4);
  }

  /* Entrance animation for the module — triggered by scroll position
     (see the script below), not on page load: this section is below
     the fold for most people, and a load-time animation finishes
     long before anyone has scrolled down far enough to see it.
     Scoped to .exp-intro only, not .exp-stage: a transform on an
     ancestor of .exp-pin can interfere with its sticky positioning,
     and .exp-stage already has its own reveal via the photo stack. */
  @media (prefers-reduced-motion: no-preference) {
    .exp-intro {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }

    .exp-intro.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .exp-title {
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: clamp(40px, 7vw, 72px);
    line-height: 1.1;
    margin: 0 0 var(--space-3);
  }

  .exp-counter {
    font-variant-numeric: tabular-nums;
  }

  .exp-subtitle {
    font-size: clamp(17px, 2vw, 20px);
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* Module 2: experience scroll-stage. .exp-stage gives extra scroll
     room (one "step" per company) for the reveal; .exp-pin is what
     stays stuck to the viewport while that room scrolls past. 35vh
     turned out too twitchy (a tiny nudge already flipped company);
     60vh is a middle ground between that and the original 90vh. */
  .exp-stage {
    position: relative;
    height: calc(var(--exp-steps, 3) * 60vh);
  }

  /* .exp-pin's sticky containing block is .wrap (its direct parent),
     not .exp-stage — .wrap has no height of its own, so without this
     it just shrinks to .exp-pin's height, leaving zero room to
     stick. height: 100% pulls the full .exp-stage height through. */
  .exp-stage > .wrap {
    height: 100%;
  }

  .exp-pin {
    --exp-pin-h: min(78vh, 640px);
    /* The company photos are 3850x4820 — this is that exact ratio,
       used below so the media column's width strictly matches the
       photos' own proportions instead of an arbitrary clamp. */
    --exp-media-ratio: calc(3850 / 4820);
    position: sticky;
    top: 96px;
    height: var(--exp-pin-h);
    display: grid;
    grid-template-columns: calc(var(--exp-pin-h) * var(--exp-media-ratio)) 1fr;
    gap: var(--space-6);
    align-items: stretch;
    padding-block: var(--space-4);
  }

  /* .exp-media gets this height written out directly (matching
     .exp-pin's own) rather than via height:100% — with
     absolutely-positioned-only children inside a grid item, the
     percentage-height chain doesn't reliably resolve to the row's
     real height (align-items:stretch alone didn't fix it either;
     it kept landing at the content height of whichever photo
     happened to be tallest instead of the pin's real height), so
     this sidesteps that resolution entirely. .exp-list doesn't need
     it — it's back to a normal-flow list, not absolutely positioned. */
  .exp-media {
    position: relative;
    height: var(--exp-pin-h);
    overflow: hidden;
    border-radius: 30px;
  }

  /* Each photo (after the first) sits translated fully below the
     frame until its turn, then slides up to translateY(0) and stays
     there, stacking on top of whichever one came before it — see the
     per-image z-index below and the transform math in the script.
     No transition here on purpose: this transform is set on every
     scroll event to directly track scroll position, like a scrubber.
     A CSS transition would make it perpetually ease toward a moving
     target instead of matching the actual scroll position, which is
     exactly what made it feel out of sync with the text. */
  .exp-media :global(.exp-media-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: translateY(100%);
  }

  .exp-media :global(.exp-media-img:first-child) {
    transform: translateY(0);
  }

  .exp-media :global(.exp-media-img:nth-child(1)) {
    z-index: 1;
  }
  .exp-media :global(.exp-media-img:nth-child(2)) {
    z-index: 2;
  }
  .exp-media :global(.exp-media-img:nth-child(3)) {
    z-index: 3;
  }
  .exp-media :global(.exp-media-img:nth-child(4)) {
    z-index: 4;
  }

  /* "Drawer" list: all three company names stay visible at all
     times (a persistent list, not a stack that covers them), and
     only the active company's detail panel opens — driven every
     frame by the exact same reveal/nextReveal windows used for the
     photo stack (see the script below), so the two switch at the
     same scroll position. No transition on .exp-item-detail's
     grid-template-rows/opacity — same reason the photo has none:
     both are reassigned every scroll frame, and a CSS transition
     would make them perpetually ease toward a moving target instead
     of tracking the actual scroll position. */
  .exp-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .exp-item-name {
    margin: 0;
    font-weight: 700;
    font-size: clamp(20px, 2.6vw, 28px);
    color: var(--color-ink);
  }

  .exp-item-detail {
    display: grid;
    grid-template-rows: minmax(0, 0fr);
    opacity: 0;
  }

  .exp-item-detail-inner {
    overflow: hidden;
  }

  .exp-item-meta {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--color-ink-faint);
  }

  .exp-role {
    margin-top: var(--space-3);
  }

  .exp-role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .exp-role-title {
    margin: 0;
    font-weight: 600;
    font-size: 15px;
  }

  .exp-role-date {
    margin: 0;
    font-size: 13px;
    color: var(--color-ink-faint);
    white-space: nowrap;
  }

  .exp-role-desc {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* Module 3 */
  .focus-intro {
    text-align: center;
    /* On top of .section's own padding-top (var(--space-7)) — .exp-
       stage (Module 2) has no bottom padding of its own, so without
       this the gap between the two modules is noticeably tighter
       than the gap around every other section. */
    margin-top: var(--space-6);
  }

  /* Scroll-triggered entrance, same as .exp-intro — this is below
     the fold, so the class gets added by the shared
     setupIntroReveal() call once it scrolls into view. */
  @media (prefers-reduced-motion: no-preference) {
    .focus-intro {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }

    .focus-intro.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .focus-title {
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: clamp(34px, 5.5vw, 60px);
    line-height: 1.15;
    margin: 0 0 var(--space-3);
  }

  .focus-counter {
    font-variant-numeric: tabular-nums;
  }

  .focus-subtitle {
    font-size: clamp(17px, 2vw, 20px);
    color: var(--color-ink-soft);
    margin: 0 0 var(--space-5);
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .focus-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: var(--space-4) var(--space-3);
    background: rgba(23, 20, 15, 0.04);
    border-radius: 20px;
  }

  .focus-icon-wrap {
    width: 140px;
    max-width: 55%;
    margin-bottom: 6px;
  }

  .focus-tag {
    font-weight: 700;
    font-size: 17px;
    margin: 0;
  }

  .focus-card p:last-child {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* Full-bleed closing banner: dark ink background (not a new brand
     color), white text, big bold statement, one light button. */
  .cta-banner {
    background: var(--color-ink);
    color: #fff;
    text-align: center;
    padding-block: var(--space-7);
  }

  /* Scroll-triggered entrance, same mechanism as .exp-intro/
     .focus-intro (setupIntroReveal(), called with no counter for
     this one — see the script below). */
  @media (prefers-reduced-motion: no-preference) {
    .cta-banner {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }

    .cta-banner.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cta-eyebrow {
    color: rgba(255, 255, 255, 0.6);
  }

  .cta-statement {
    font-weight: 700;
    letter-spacing: -0.01em;
    font-size: clamp(26px, 3.4vw, 42px);
    line-height: 1.35;
    max-width: 900px;
    margin: var(--space-3) auto var(--space-5);
  }

  .cta-statement em {
    font-style: italic;
    color: var(--color-accent);
  }

  @media (max-width: 800px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }

    :global(.intro-photo) {
      max-width: 320px;
      margin-inline: auto;
    }

    .focus-grid {
      grid-template-columns: 1fr;
    }

    /* No room for a 2-column sticky scroll effect here, and no real
       scroll-driven "reveal" reason to keep it on a touch device —
       drop straight to a plain, fully expanded list. */
    .exp-stage {
      height: auto;
    }

    .exp-pin {
      position: static;
      height: auto;
      display: block;
    }

    .exp-media {
      display: none;
    }

    .exp-item-detail {
      grid-template-rows: minmax(0, 1fr);
      opacity: 1;
    }
  }
</style>

<script>
  // Scroll-driven "which company is active" for the experience
  // section: as the user scrolls through .exp-stage's extra height,
  // each company's name/photo becomes active in turn while .exp-pin
  // stays stuck. Same technique as the Home hero reveal — a plain
  // scroll listener recomputing state each event, no rAF (trivial
  // per-event cost, and rAF can stay starved in backgrounded tabs).
  function setupExperienceScroll() {
    const stage = document.querySelector<HTMLElement>(".exp-stage");
    const pin = document.querySelector<HTMLElement>(".exp-pin");
    const items = document.querySelectorAll<HTMLElement>(".exp-item");
    const images = document.querySelectorAll<HTMLElement>(".exp-media-img");
    if (!stage || !pin || items.length === 0) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion) {
      // Skip the scroll-driven step-through entirely: every name
      // stays visible (it's a normal-flow list, nothing to reset
      // there) and every detail panel opens fully, with no extra
      // scroll room needed. The photo stack has no story to tell
      // without the scroll-linked motion, so hide that column
      // entirely (same call as the mobile fallback below 800px).
      stage.style.height = "auto";
      pin.style.position = "static";
      pin.style.height = "auto";
      pin.style.display = "block";
      const media = document.querySelector<HTMLElement>(".exp-media");
      if (media) media.style.display = "none";
      items.forEach((item) => {
        const detail = item.querySelector<HTMLElement>(".exp-item-detail");
        if (detail) {
          detail.style.gridTemplateRows = "minmax(0, 1fr)";
          detail.style.opacity = "1";
        }
      });
      return;
    }

    const count = items.length;

    // Each company's photo/detail-panel opens over the last WINDOW
    // fraction of the step before it, finishing right on the
    // whole-number boundary — not spread across the whole step —
    // and the one before it closes in that same window, so both
    // columns switch at the same scroll position instead of drifting
    // out of sync with each other.
    const WINDOW = 0.4;
    function stepProgress(raw: number, boundary: number) {
      return Math.max(0, Math.min(1, (raw - (boundary - WINDOW)) / WINDOW));
    }

    function update() {
      const rect = stage!.getBoundingClientRect();
      const scrollRange = Math.max(1, stage!.offsetHeight - pin!.offsetHeight);
      const progress = Math.min(1, Math.max(0, -rect.top / scrollRange));
      const raw = progress * count; // continuous, 0..count

      // Photo stack: each one slides up from translateY(100%) to
      // 0% and stays there, stacking on top of the one before it,
      // which shrinks away (scale -> 0) in the same window.
      images.forEach((img, i) => {
        const reveal = i === 0 ? 1 : stepProgress(raw, i);
        const nextReveal = i < count - 1 ? stepProgress(raw, i + 1) : 0;
        const scale = 1 - nextReveal;
        img.style.transform = `translateY(${(1 - reveal) * 100}%) scale(${scale})`;
      });

      // Drawer list: every name stays visible (plain, normal-flow
      // list — see .exp-list), and each item's own detail panel
      // opens (reveal) then closes again (nextReveal) as the next
      // one's turn arrives, using the exact same window values as
      // the photo above so both switch together.
      items.forEach((item, i) => {
        const reveal = i === 0 ? 1 : stepProgress(raw, i);
        const nextReveal = i < count - 1 ? stepProgress(raw, i + 1) : 0;
        const expand = Math.max(0, reveal - nextReveal);
        const detail = item.querySelector<HTMLElement>(".exp-item-detail");
        if (detail) {
          detail.style.gridTemplateRows = `minmax(0, ${expand}fr)`;
          detail.style.opacity = String(expand);
        }
      });
    }

    // Each company's "window" is a fairly narrow slice of the total
    // scrollable distance. A plain 'scroll' listener only recomputes
    // on whatever events the browser happens to batch out — and
    // trackpad momentum/fling scrolling can easily cover an entire
    // company's window between two such events, so the state jumps
    // straight from one company to the one after next, skipping the
    // one in between entirely (its window was never sampled). Running
    // a requestAnimationFrame loop for as long as scrolling seems to
    // be happening samples every rendered frame instead, so there's
    // no gap fast scrolling can jump across.
    let lastScrollAt = 0;
    let looping = false;

    function loop() {
      update();
      if (performance.now() - lastScrollAt < 200) {
        requestAnimationFrame(loop);
      } else {
        looping = false;
      }
    }

    function onScroll() {
      lastScrollAt = performance.now();
      if (!looping) {
        looping = true;
        requestAnimationFrame(loop);
      }
    }

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", update);
  }

  setupExperienceScroll();

  // Reveal a section (fade + lift, if its CSS opts in via .is-visible)
  // and count its number up 0->target the first time it scrolls into
  // view. Driven by a plain scroll listener + getBoundingClientRect,
  // same technique as the company switcher above (not
  // IntersectionObserver) — this only needs to fire once per section,
  // so each call unregisters itself after triggering. Shared by both
  // "Over 12 years..." and "Over 7 years..." — same mechanism, two
  // different sections/counters.
  function setupIntroReveal(sectionSelector: string, counterSelector?: string) {
    const intro = document.querySelector<HTMLElement>(sectionSelector);
    const counter = counterSelector
      ? document.querySelector<HTMLElement>(counterSelector)
      : null;
    if (!intro) return;

    const target = Number(counter?.dataset.target ?? "0");
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion) {
      intro.classList.add("is-visible");
      if (counter) counter.textContent = String(target);
      return;
    }

    function runCounter() {
      if (!counter) return;
      const duration = 700;
      const start = performance.now();
      function tick(now: number) {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
        counter.textContent = String(Math.round(eased * target));
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    function check() {
      const rect = intro.getBoundingClientRect();
      // Trigger once the section is meaningfully on screen, not just
      // a sliver of it peeking in at the very edge.
      if (rect.top < window.innerHeight * 0.85 && rect.bottom > 0) {
        intro.classList.add("is-visible");
        runCounter();
        window.removeEventListener("scroll", check);
      }
    }

    check(); // covers the case where it's already in view at load
    window.addEventListener("scroll", check, { passive: true });
  }

  setupIntroReveal(".exp-intro", ".exp-counter");
  setupIntroReveal(".focus-intro", ".focus-counter");
  setupIntroReveal(".cta-banner");
</script>
