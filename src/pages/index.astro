---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";
import { categoryCards } from "../data/categories";
import { peopleCards } from "../data/peopleCards";
import heroPhoto from "../assets/hero.png";
---

<BaseLayout title="Lin Hongyu — Monee Design Head">
  <!-- Hero / identity: pinned scroll reveal (PayPal-style) — headline
       fades out and the photo grows to fill the screen with the name
       overlaid, then normal scrolling continues into the bio below -->
  <section class="hero-stage">
    <div class="hero-pin">
      <div class="hero-copy">
        <h1 class="headline">
          Business is the destination.<br />User experience is the art
          of getting there.
        </h1>
      </div>
      <div class="hero-media">
        <Image
          src={heroPhoto}
          alt="Lin Hongyu, surrounded by pelicans, holding up a Mari Bank card"
          widths={[480, 800, 1200, 1600, 2000]}
          sizes="100vw"
          class="hero-media-img"
        />
        <div class="hero-media-overlay"></div>
        <p class="hero-name">Lin Hongyu</p>
      </div>
    </div>
  </section>

  <section class="section hero-bio">
    <div class="wrap hero-bio-grid">
      <div class="hero-bio-copy">
        <h2 class="hero-bio-name">Lin Hongyu</h2>
        <p class="hero-bio-text">
          The Head of Design at Monee, with over 12 years of
          experience in product design and 7 years in design
          management.
        </p>
        <p class="hero-bio-text">
          I am leading a team of 30+, overseeing brand, product, and
          marketing design across everything we do: Digital Bank,
          Payment, Loan, Investment, and Insurance.
        </p>
        <a class="btn" href="/about">
          Know more about me <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <PlaceholderImage
        ratio="4/5"
        radius="24px"
        label="Personal photo"
        class="hero-bio-photo"
      />
    </div>
  </section>

  <!-- Design philosophy: full-bleed dark banner, PayPal Open-style -->
  <section class="section philosophy">
    <div class="wrap">
      <p class="eyebrow eyebrow--accent">On Design</p>
      <h2 class="philosophy-lead">A business-minded designer lead</h2>
      <p class="philosophy-sub">
        Translates strategy into design. Connects resources to boost
        efficiency. Drives the skill evolution and role elevation.
      </p>
      <div class="philosophy-scroll-cue">
        <span>Scroll to see the work</span>
        <span class="scroll-arrow" aria-hidden="true">&darr;</span>
      </div>
    </div>
  </section>

  <!-- About Project -->
  <section class="section" id="project">
    <div class="wrap">
      <div class="section-head">
        <h2>About project</h2>
        <p class="section-note">
          I see myself as a Business Designer — defining design
          strategy through a business-growth lens, and safeguarding
          the quality of what we ship.
        </p>
      </div>
      <div class="category-grid">
        {categoryCards.map((card) => <CategoryCard card={card} />)}
      </div>
    </div>
  </section>

  <!-- About People -->
  <section class="section" id="about">
    <div class="wrap">
      <div class="section-head">
        <h2>About people</h2>
        <p class="section-note">
          I see myself as a coach — connecting and aligning resources
          to raise team efficiency, and leading the evolution of
          skills and the elevation of roles.
        </p>
      </div>
      <div class="category-grid">
        {peopleCards.map((card) => <CategoryCard card={card} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Pinned scroll stage: .hero-stage gives extra scroll room (120vh)
     for the reveal; .hero-pin is what actually stays stuck to the
     top of the viewport while that room scrolls past. */
  .hero-stage {
    position: relative;
    height: 220vh;
  }

  .hero-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .hero-copy {
    position: absolute;
    top: 108px;
    left: 50%;
    z-index: 2;
    width: min(94%, 1240px);
    transform: translateX(-50%);
    text-align: center;
    opacity: 1;
  }

  .headline {
    max-width: 1240px;
    margin-inline: auto;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.1;
    margin-block: 0;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Page-load entrance: the headline and the photo rise into place.
     Lives on .headline/.hero-media themselves (not .hero-copy), which
     is what the scroll-reveal script controls — so the two animations
     never fight over the same element's opacity/transform. */
  @media (prefers-reduced-motion: no-preference) {
    .headline {
      animation: hero-copy-enter 1.6s cubic-bezier(0.19, 1, 0.22, 1) 0.1s
        both;
    }

    .hero-media {
      animation: hero-media-enter 1.9s cubic-bezier(0.19, 1, 0.22, 1) 0.35s
        both;
    }
  }

  @keyframes hero-copy-enter {
    from {
      opacity: 0;
      transform: translateY(36px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-media-enter {
    from {
      opacity: 0;
      transform: translateY(90px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Starting framed/inset look — a docked "card" sitting below the
       headline, not overlapping it. JS drives this toward a
       full-bleed, square-cornered image as the user scrolls. Kept in
       sync with the JS defaults below so the pre-JS/no-JS state
       still looks intentional. */
    clip-path: inset(46% 18% 10% 18% round 40px);
  }

  .hero-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55),
      rgba(0, 0, 0, 0) 60%
    );
    opacity: 0;
  }

  .hero-name {
    position: absolute;
    left: 50%;
    bottom: 8%;
    transform: translate(-50%, 20px);
    margin: 0;
    color: #fff;
    font-weight: 700;
    letter-spacing: -0.01em;
    font-size: clamp(32px, 6vw, 64px);
    opacity: 0;
  }

  .hero-bio {
    padding-top: var(--space-6);
  }

  /* Text-left/photo-right, like Module 1 of the About page — a
     deliberate left-aligned exception to the rest of Home's
     centered sections, since it's a bio+portrait layout, not a
     marketing statement. */
  .hero-bio-grid {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 420px);
    gap: var(--space-6);
    align-items: center;
    text-align: left;
  }

  .hero-bio-name {
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05;
    margin: 0 0 var(--space-3);
  }

  .hero-bio-text {
    max-width: 480px;
    font-size: clamp(16px, 1.8vw, 18px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    margin-bottom: var(--space-2);
  }

  .hero-bio-copy .btn {
    margin-top: var(--space-3);
  }

  /* Full-bleed dark banner — the one deliberate exception to the
     page's white background, matching the PayPal Open-style
     reference: big lead statement, sub-copy, scroll-down cue. */
  .philosophy {
    background: var(--color-ink);
    color: #fff;
    text-align: center;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .philosophy .wrap {
    width: 100%;
  }

  .philosophy .eyebrow--accent {
    color: var(--color-accent);
  }

  .philosophy-lead {
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(34px, 5.5vw, 64px);
    line-height: 1.08;
    max-width: 880px;
    margin: var(--space-2) auto 0;
  }

  .philosophy-sub {
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.68);
    max-width: 640px;
    margin: var(--space-3) auto 0;
  }

  .philosophy-scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-top: var(--space-5);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .scroll-arrow {
    font-size: 18px;
    line-height: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll-arrow {
      animation: scroll-cue-bounce 1.8s ease-in-out infinite;
    }
  }

  @keyframes scroll-cue-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  h2 {
    font-size: clamp(26px, 3vw, 34px);
    margin-top: 6px;
  }

  .section-note {
    font-size: 15px;
    color: var(--color-ink-faint);
    max-width: 580px;
    margin-inline: auto;
  }

  /* Flex row (not grid): equal-width by default, but the accordion
     hover interaction (in CategoryCard.astro) drives each card's
     flex-grow, so width has to come from flex, not fixed columns.
     Height is fixed here instead of via aspect-ratio, so a card
     growing wider doesn't also grow taller. */
  .category-grid {
    display: flex;
    gap: var(--space-3);
    height: min(56vh, 520px);
  }

  @media (max-width: 900px) {
    .category-grid {
      flex-direction: column;
      height: auto;
      max-width: 420px;
      margin-inline: auto;
    }

    .hero-bio-grid {
      grid-template-columns: 1fr;
    }

    .hero-bio-text {
      max-width: none;
    }
  }

  @media (max-width: 700px) {
    .hero-stage {
      height: 180vh;
    }
  }
</style>

<script>
  // Pinned scroll reveal for the hero: as the user scrolls through
  // .hero-stage's extra height, the headline fades out and the photo
  // grows from a framed inset to full-bleed, with the name fading in
  // over it. Driven by scroll position rather than CSS scroll-timeline
  // for broader browser support.
  function setupHeroReveal() {
    const stage = document.querySelector<HTMLElement>(".hero-stage");
    const copy = document.querySelector<HTMLElement>(".hero-copy");
    const img = document.querySelector<HTMLElement>(".hero-media-img");
    const overlay = document.querySelector<HTMLElement>(".hero-media-overlay");
    const name = document.querySelector<HTMLElement>(".hero-name");
    if (!stage || !copy || !img || !overlay || !name) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion) {
      // Skip the scroll-jacked animation; land straight on the end
      // state (full-bleed photo, name visible) with no extra scroll
      // room needed.
      stage.style.height = "100vh";
      copy.style.opacity = "0";
      img.style.clipPath = "inset(0 round 0px)";
      overlay.style.opacity = "1";
      name.style.opacity = "1";
      name.style.transform = "translate(-50%, 0)";
      return;
    }

    function update() {
      const rect = stage.getBoundingClientRect();
      const scrollRange = Math.max(1, stage.offsetHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, -rect.top / scrollRange));

      const copyProgress = Math.min(1, progress / 0.5);
      copy.style.opacity = String(1 - copyProgress);
      copy.style.transform = `translate(-50%, ${-copyProgress * 30}px)`;

      // Docked "card" (below the headline) -> full-bleed. Top inset
      // shrinks fastest so the growing photo doesn't reach the
      // headline's old spot until well after the headline has faded.
      const insetTop = 46 * (1 - progress);
      const insetSide = 18 * (1 - progress);
      const insetBottom = 10 * (1 - progress);
      const radius = 40 * (1 - progress);
      img.style.clipPath = `inset(${insetTop}% ${insetSide}% ${insetBottom}% ${insetSide}% round ${radius}px)`;

      const nameProgress = Math.max(0, (progress - 0.5) / 0.5);
      overlay.style.opacity = String(nameProgress);
      name.style.opacity = String(nameProgress);
      name.style.transform = `translate(-50%, ${(1 - nameProgress) * 20}px)`;
    }

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  setupHeroReveal();
</script>
