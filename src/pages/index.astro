---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseCard from "../components/CaseCard.astro";
import PeopleCard from "../components/PeopleCard.astro";
import { workCases } from "../data/work";
import { peopleTopics } from "../data/people";
import heroPhoto from "../assets/hero.png";
---

<BaseLayout title="Lin Hongyu — Monee Design Head">
  <!-- Hero / identity: pinned scroll reveal (PayPal-style) — headline
       fades out and the photo grows to fill the screen with the name
       overlaid, then normal scrolling continues into the bio below -->
  <section class="hero-stage">
    <div class="hero-pin">
      <div class="hero-copy">
        <h1 class="headline">
          Design that grows the business, not just the interface.
        </h1>
      </div>
      <div class="hero-media">
        <Image
          src={heroPhoto}
          alt="Lin Hongyu, surrounded by pelicans, holding up a Mari Bank card"
          widths={[480, 800, 1200, 1600, 2000]}
          sizes="100vw"
          class="hero-media-img"
        />
        <div class="hero-media-overlay"></div>
        <p class="hero-name">Lin Hongyu</p>
      </div>
    </div>
  </section>

  <section class="section hero-bio">
    <div class="wrap">
      <p class="lead">
        Overseeing brand, product, and operations design across everything Monee — one corporate brand, <strong>Monee Corporate</strong>, and five core business lines: <strong>Digital Bank</strong>, <strong>Payment</strong>, <strong>Loan</strong>, <strong>Investment</strong>, and <strong>Insurance</strong>.
      </p>
      <ul class="scope-list">
        <li>
          Focus on business growth and user experience — define design
          strategy and safeguard the quality of what ships.
        </li>
        <li>Connect and align resources across teams to raise efficiency.</li>
        <li>
          Lead the evolution of craft and the growth of design roles.
        </li>
      </ul>
    </div>
  </section>

  <!-- Design philosophy -->
  <section class="section philosophy">
    <div class="wrap">
      <p class="eyebrow">On Design</p>
      <p class="statement">
        I see myself as a <em>Business Designer</em> — someone who reads
        product and user-experience design through a business lens.
        Business growth is the goal; user experience and product strategy
        are how we get there.
      </p>
    </div>
  </section>

  <!-- About Project -->
  <section class="section" id="project">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--accent">About Project</p>
          <h2>Work</h2>
        </div>
        <p class="section-note">
          From ecosystem-level strategy to the shape of a single product
          decision.
        </p>
      </div>
      <div class="work-grid">
        {workCases.map((work) => <CaseCard work={work} />)}
      </div>
    </div>
  </section>

  <!-- About People -->
  <section class="section" id="about">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--accent">About People</p>
          <h2>Leading People</h2>
        </div>
        <p class="section-note">Building the team that builds the work.</p>
      </div>
      <div class="people-grid">
        {peopleTopics.map((topic) => <PeopleCard topic={topic} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Pinned scroll stage: .hero-stage gives extra scroll room (120vh)
     for the reveal; .hero-pin is what actually stays stuck to the
     top of the viewport while that room scrolls past. */
  .hero-stage {
    position: relative;
    height: 220vh;
  }

  .hero-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .hero-copy {
    position: absolute;
    top: 108px;
    left: 50%;
    z-index: 2;
    width: min(90%, 900px);
    transform: translateX(-50%);
    text-align: center;
    opacity: 1;
  }

  .headline {
    max-width: 760px;
    margin-inline: auto;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1.1;
    margin-block: 0;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Page-load entrance: the headline and the photo rise into place.
     Lives on .headline/.hero-media themselves (not .hero-copy), which
     is what the scroll-reveal script controls — so the two animations
     never fight over the same element's opacity/transform. */
  @media (prefers-reduced-motion: no-preference) {
    .headline {
      animation: hero-copy-enter 1.6s cubic-bezier(0.19, 1, 0.22, 1) 0.1s
        both;
    }

    .hero-media {
      animation: hero-media-enter 1.9s cubic-bezier(0.19, 1, 0.22, 1) 0.35s
        both;
    }
  }

  @keyframes hero-copy-enter {
    from {
      opacity: 0;
      transform: translateY(36px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-media-enter {
    from {
      opacity: 0;
      transform: translateY(90px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Starting framed/inset look — a docked "card" sitting below the
       headline, not overlapping it. JS drives this toward a
       full-bleed, square-cornered image as the user scrolls. Kept in
       sync with the JS defaults below so the pre-JS/no-JS state
       still looks intentional. */
    clip-path: inset(46% 18% 10% 18% round 40px);
  }

  .hero-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55),
      rgba(0, 0, 0, 0) 60%
    );
    opacity: 0;
  }

  .hero-name {
    position: absolute;
    left: 50%;
    bottom: 8%;
    transform: translate(-50%, 20px);
    margin: 0;
    color: #fff;
    font-weight: 700;
    letter-spacing: -0.01em;
    font-size: clamp(32px, 6vw, 64px);
    opacity: 0;
  }

  .hero-bio {
    padding-top: var(--space-4);
    text-align: center;
  }

  .lead {
    max-width: 640px;
    margin-inline: auto;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin-bottom: var(--space-5);
  }

  .lead strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .scope-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    max-width: 560px;
    margin-inline: auto;
  }

  .scope-list li {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .philosophy {
    text-align: center;
  }

  .philosophy .statement {
    font-weight: 500;
    letter-spacing: -0.01em;
    font-size: clamp(24px, 3.4vw, 38px);
    line-height: 1.35;
    max-width: 900px;
    margin-inline: auto;
    margin-top: var(--space-3);
  }

  .philosophy .statement em {
    font-style: italic;
    color: var(--color-accent);
  }

  h2 {
    font-size: clamp(26px, 3vw, 34px);
    margin-top: 6px;
  }

  .section-note {
    font-size: 15px;
    color: var(--color-ink-faint);
    max-width: 440px;
    margin-inline: auto;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4) var(--space-3);
  }

  .people-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  @media (max-width: 900px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .people-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .hero-stage {
      height: 180vh;
    }
  }
</style>

<script>
  // Pinned scroll reveal for the hero: as the user scrolls through
  // .hero-stage's extra height, the headline fades out and the photo
  // grows from a framed inset to full-bleed, with the name fading in
  // over it. Driven by scroll position rather than CSS scroll-timeline
  // for broader browser support.
  function setupHeroReveal() {
    const stage = document.querySelector<HTMLElement>(".hero-stage");
    const copy = document.querySelector<HTMLElement>(".hero-copy");
    const img = document.querySelector<HTMLElement>(".hero-media-img");
    const overlay = document.querySelector<HTMLElement>(".hero-media-overlay");
    const name = document.querySelector<HTMLElement>(".hero-name");
    if (!stage || !copy || !img || !overlay || !name) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion) {
      // Skip the scroll-jacked animation; land straight on the end
      // state (full-bleed photo, name visible) with no extra scroll
      // room needed.
      stage.style.height = "100vh";
      copy.style.opacity = "0";
      img.style.clipPath = "inset(0 round 0px)";
      overlay.style.opacity = "1";
      name.style.opacity = "1";
      name.style.transform = "translate(-50%, 0)";
      return;
    }

    function update() {
      const rect = stage.getBoundingClientRect();
      const scrollRange = Math.max(1, stage.offsetHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, -rect.top / scrollRange));

      const copyProgress = Math.min(1, progress / 0.5);
      copy.style.opacity = String(1 - copyProgress);
      copy.style.transform = `translate(-50%, ${-copyProgress * 30}px)`;

      // Docked "card" (below the headline) -> full-bleed. Top inset
      // shrinks fastest so the growing photo doesn't reach the
      // headline's old spot until well after the headline has faded.
      const insetTop = 46 * (1 - progress);
      const insetSide = 18 * (1 - progress);
      const insetBottom = 10 * (1 - progress);
      const radius = 40 * (1 - progress);
      img.style.clipPath = `inset(${insetTop}% ${insetSide}% ${insetBottom}% ${insetSide}% round ${radius}px)`;

      const nameProgress = Math.max(0, (progress - 0.5) / 0.5);
      overlay.style.opacity = String(nameProgress);
      name.style.opacity = String(nameProgress);
      name.style.transform = `translate(-50%, ${(1 - nameProgress) * 20}px)`;
    }

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  setupHeroReveal();
</script>
