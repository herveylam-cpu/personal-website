---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";
import { projectStackCards } from "../data/projectStack";
---

<BaseLayout
  title="Project — Lin Hongyu"
  description="Case studies across strategy, brand tone, and product design."
>
  <section class="section project-hero">
    <div class="wrap">
      <p class="eyebrow eyebrow--accent">Work</p>
      <h1>About project</h1>
    </div>
  </section>

  <!-- Stacking card list: every card sticks at the same top offset
       (so an incoming one lands exactly over the one before it), with
       margin between them for breathing room in normal scroll. As
       each next card approaches its own pin point, a script shrinks
       and fades the card it's about to cover (see setupProjectStack
       below) — sticky itself only handles the slide-up-then-hold
       part, not that transition. -->
  <section class="project-stack">
    <div class="wrap">
      {
        projectStackCards.map((card, i) => (
          <div class="project-card" style={`--stack-i: ${i};`}>
            <div class="project-card-copy">
              <p class="eyebrow eyebrow--accent">{card.tag}</p>
              <h2 class="project-card-title">{card.title}</h2>
              <p class="project-card-subtitle">{card.subtitle}</p>
              <a class="btn btn--light" href={`/work/${card.slug}`}>
                {card.buttonLabel}
                <span class="arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            </div>
            {card.image ? (
              <Image
                src={card.image}
                alt={card.imageAlt}
                widths={[480, 720, 960]}
                sizes="(max-width: 900px) 90vw, 440px"
                class="project-card-img"
              />
            ) : (
              <PlaceholderImage
                ratio="4/5"
                radius="0"
                label={`${card.tag} photo`}
                class="project-card-img"
              />
            )}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .project-hero {
    text-align: center;
    padding-bottom: var(--space-4);
  }

  .project-hero h1 {
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(34px, 5.5vw, 56px);
    margin-top: var(--space-2);
  }

  .project-stack {
    padding-bottom: var(--space-7);
  }

  /* Same sticky-top offset (96px, matching the header's own height)
     as the About page's exp-pin — every card shares it, so an
     incoming one lands exactly over the one it's covering. z-index
     climbs per card so each later one paints over the ones before.
     margin-bottom is the gap between cards during normal scroll,
     before the covering transition starts. Alternating tone + a cast
     shadow read as depth once the covered card is shrunk down behind
     the incoming one. transform/opacity are NOT transitioned here —
     setupProjectStack sets them every scroll frame to directly track
     scroll position; a CSS transition would make them perpetually
     ease toward a moving target instead (same reason the About page's
     photo stack skips one too). */
  .project-card {
    position: sticky;
    top: 96px;
    z-index: calc(var(--stack-i, 0) + 1);
    height: min(74vh, 580px);
    margin-bottom: var(--space-5);
    border-radius: 32px;
    overflow: hidden;
    background: var(--color-ink);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
    color: #fff;
    display: grid;
    grid-template-columns: 1fr minmax(300px, 440px);
    align-items: stretch;
  }

  .project-card:nth-child(even) {
    background: #262119;
  }

  .project-card-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6);
    min-width: 0;
  }

  .project-card-title {
    font-weight: 700;
    letter-spacing: -0.01em;
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.3;
    margin: 0;
    max-width: 520px;
  }

  .project-card-subtitle {
    color: rgba(255, 255, 255, 0.7);
    font-size: 15px;
    line-height: 1.6;
    max-width: 460px;
    margin: 0;
  }

  .project-card-copy .btn {
    margin-top: var(--space-2);
  }

  .project-card :global(.project-card-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .project-card {
      position: static;
      top: auto;
      height: auto;
      /* No shrink/fade transition to run without sticky, and no
         scroll listener bothering to compute one either (see the
         script's own reduced-motion-style bail-out below). */
      transform: none !important;
      opacity: 1 !important;
      grid-template-columns: 1fr;
    }

    .project-card :global(.project-card-img) {
      height: 260px;
    }
  }
</style>

<script>
  // As each card approaches its own sticky pin point (96px from the
  // top), shrink and fade the card just before it in the stack, so
  // it visibly recedes as the incoming one covers it — sticky itself
  // only handles the "slide up, then hold" part; this is the extra
  // transition on top of that.
  function setupProjectStack() {
    const cards = document.querySelectorAll<HTMLElement>(".project-card");
    if (cards.length < 2) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    // Also a no-op below 900px, where cards fall back to a plain
    // static list (media query above forces transform/opacity back
    // to their rest state either way).
    if (prefersReducedMotion || window.matchMedia("(max-width: 900px)").matches) {
      return;
    }

    const STICKY_TOP = 96;
    // How much scroll distance (px) the shrink/fade plays out over,
    // ending exactly as the next card reaches its own pin point.
    const WINDOW = 260;
    const MAX_SHRINK = 0.08;
    const MAX_FADE = 0.85;

    function update() {
      cards.forEach((card, i) => {
        const next = cards[i + 1];
        if (!next) {
          card.style.transform = "";
          card.style.opacity = "";
          return;
        }
        const nextTop = next.getBoundingClientRect().top;
        const progress = Math.min(
          1,
          Math.max(0, (STICKY_TOP + WINDOW - nextTop) / WINDOW)
        );
        card.style.transform = `scale(${1 - progress * MAX_SHRINK})`;
        card.style.opacity = String(1 - progress * MAX_FADE);
      });
    }

    // Same rAF-while-scrolling technique as the About page's
    // experience stack: a plain 'scroll' listener can miss a card's
    // whole transition window during a fast/momentum scroll, so this
    // keeps sampling every rendered frame for a bit after each event
    // instead of only reacting to the (sparser) scroll events
    // themselves.
    let lastScrollAt = 0;
    let looping = false;

    function loop() {
      update();
      if (performance.now() - lastScrollAt < 200) {
        requestAnimationFrame(loop);
      } else {
        looping = false;
      }
    }

    function onScroll() {
      lastScrollAt = performance.now();
      if (!looping) {
        looping = true;
        requestAnimationFrame(loop);
      }
    }

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", update);
  }

  setupProjectStack();
</script>
