---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";
import { teamStackCards } from "../data/teamStack";
---

<BaseLayout
  title="Team — Lin Hongyu"
  description="How I build and grow the team: consensus, capability, and the AI-native design platform."
>
  <section class="section project-hero">
    <div class="wrap">
      <p class="eyebrow eyebrow--accent">Team</p>
      <h1>About team</h1>
    </div>
  </section>

  <!-- Same stacking card list as /project — see that page's comment
       for how the sticky-stack + shrink-on-cover effect works. -->
  <section class="project-stack">
    <div class="wrap">
      {
        teamStackCards.map((card, i) => (
          <div class="project-card" style={`--stack-i: ${i};`}>
            <div class="project-card-copy">
              <p class="eyebrow eyebrow--accent">{card.tag}</p>
              <h2 class="project-card-title">{card.title}</h2>
              <p class="project-card-subtitle">{card.subtitle}</p>
              <a class="btn btn--light" href={`/people/${card.slug}`}>
                {card.buttonLabel}
                <span class="arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            </div>
            {card.image ? (
              <Image
                src={card.image}
                alt={card.imageAlt}
                widths={[480, 720, 960]}
                sizes="(max-width: 900px) 90vw, 440px"
                class="project-card-img"
              />
            ) : (
              <PlaceholderImage
                ratio="4/5"
                radius="0"
                label={`${card.tag} photo`}
                class="project-card-img"
              />
            )}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .project-hero {
    text-align: center;
    padding-bottom: var(--space-4);
  }

  .project-hero h1 {
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(34px, 5.5vw, 56px);
    margin-top: var(--space-2);
  }

  .project-stack {
    padding-bottom: var(--space-7);
  }

  .project-card {
    position: sticky;
    top: 96px;
    z-index: calc(var(--stack-i, 0) + 1);
    height: min(74vh, 580px);
    margin-bottom: var(--space-5);
    border-radius: 32px;
    overflow: hidden;
    background: var(--color-ink);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
    color: #fff;
    display: grid;
    grid-template-columns: 1fr minmax(300px, 440px);
    align-items: stretch;
  }

  .project-card:nth-child(even) {
    background: #262119;
  }

  .project-card-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6);
    min-width: 0;
  }

  .project-card-title {
    font-weight: 700;
    letter-spacing: -0.01em;
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.3;
    margin: 0;
    max-width: 520px;
  }

  .project-card-subtitle {
    color: rgba(255, 255, 255, 0.7);
    font-size: 15px;
    line-height: 1.6;
    max-width: 460px;
    margin: 0;
  }

  .project-card-copy .btn {
    margin-top: var(--space-2);
  }

  .project-card :global(.project-card-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .project-card {
      position: static;
      top: auto;
      height: auto;
      transform: none !important;
      grid-template-columns: 1fr;
    }

    .project-card :global(.project-card-img) {
      height: 260px;
    }
  }
</style>

<script>
  // Same sticky-stack shrink effect as /project — see that page's
  // setupProjectStack for the full reasoning.
  function setupTeamStack() {
    const cards = document.querySelectorAll<HTMLElement>(".project-card");
    if (cards.length < 2) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion || window.matchMedia("(max-width: 900px)").matches) {
      return;
    }

    const STICKY_TOP = 96;
    const MAX_SHRINK = 0.12;

    function update() {
      cards.forEach((card, i) => {
        const next = cards[i + 1];
        if (!next) {
          card.style.transform = "";
          return;
        }
        const cardHeight = card.offsetHeight;
        const overlapStart = STICKY_TOP + cardHeight;
        const nextTop = next.getBoundingClientRect().top;
        const progress = Math.min(
          1,
          Math.max(0, (overlapStart - nextTop) / cardHeight)
        );
        card.style.transform = `scale(${1 - progress * MAX_SHRINK})`;
      });
    }

    let lastScrollAt = 0;
    let looping = false;

    function loop() {
      update();
      if (performance.now() - lastScrollAt < 200) {
        requestAnimationFrame(loop);
      } else {
        looping = false;
      }
    }

    function onScroll() {
      lastScrollAt = performance.now();
      if (!looping) {
        looping = true;
        requestAnimationFrame(loop);
      }
    }

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", update);
  }

  setupTeamStack();
</script>
