  .layer-step {
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    padding: var(--space-2);
    text-align: center;
    font-weight: 700;
    font-size: 15px;
  }

  .layer-step--dark {
    background: #1c1d21;
