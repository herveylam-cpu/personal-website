---
// Tone case study — content translated from a Chinese design memo
// ("MariBank Brand Tone"), laid out to match the Strategy case page:
// same section shell (.sh headers, pills/chips, card recipes), same
// local accent override, same hero pattern reusing the Home page's
// own case image. The memo's own visual system (script webfont,
// bespoke orange tokens) isn't used — this reuses the site's
// existing component vocabulary instead.
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderImage from "../../components/PlaceholderImage.astro";
import toneImage from "../../assets/work/tone.png";
import directionAImage from "../../assets/work/direction-a.webp";
import directionBImage from "../../assets/work/direction-b.webp";
import directionCImage from "../../assets/work/direction-c.webp";
import directionDImage from "../../assets/work/direction-d.webp";

const overviewCards = [
  {
    n: "01",
    title: "Redefine what the brand means",
    body: "Use a top-down brand framework to anchor on digital-native Gen Z (16–28), make “simple” the core expression, and land on the tagline “MariBank, Just Works.”",
  },
  {
    n: "02",
    title: "Build three memory anchors",
    body: "A signature mark, a point of view behind the lens, and storytelling — with rules for when to lean “approachable” and when to lean “leading.”",
  },
  {
    n: "03",
    title: "Run it AI-native",
    body: "Standards live in a knowledge base; a multi-agent pipeline produces day-to-day assets. People define the standard and review at key checkpoints.",
  },
];

const ownedAssets = [
  { mark: "Just Works", title: "Signature mark", sub: "Handwritten script" },
  { mark: "◎", title: "Lens point of view", sub: "A distinctive shooting angle" },
  { mark: "“ ”", title: "Brand voice", sub: "Storytelling" },
];

const frameworkTop = {
  label: "Framework",
  title: "Brand operating framework",
  sub: "Defined by people, AI-assisted",
  steps: [
    { title: "Semantic layer", sub: "Positioning · tone" },
    { title: "Visual parameter layer", sub: "Locked · flexible" },
    { title: "Asset template layer", sub: "Templates · components" },
  ],
};

const frameworkBottom = {
  label: "Execution",
  title: "System execution logic",
  sub: "AI executes, people review at key checkpoints",
  steps: [
    { title: "Knowledge base", sub: "Single source of truth" },
    { title: "Skills & workflows", sub: "Multi-agent collaboration" },
    { title: "Tools", sub: "Generate · package · publish" },
  ],
};

const ageStats = [
  { label: "Current median user age", value: "~40" },
  { label: "Target · 21–30 share of new accounts", value: "20% → 60%+" },
];

const frameworkNav = [
  {
    n: "1",
    name: "Brand Purpose",
    sub: "Why we exist",
    question: "Why does MariBank exist?",
    bullets: ["What pain points do users face today?", "What can MariBank uniquely solve?"],
    outputs: ["Brand promise"],
    href: "#purpose",
  },
  {
    n: "2",
    name: "Brand Positioning",
    sub: "Who we serve",
    question: "Who does MariBank serve?",
    bullets: ["Who is the target audience?", "What are their needs, motivations, and pain points?", "How do we win them over?"],
    outputs: ["Target audience", "User insight", "Positioning statement"],
    href: "#positioning",
  },
  {
    n: "3",
    name: "Brand Expression",
    sub: "Big idea",
    question: "How should users feel about and remember MariBank? What's the big brand idea?",
    bullets: ["What emotion moves the target audience?", "What's the tagline, and how do we say it?", "What's the key message?"],
    outputs: ["Brand tagline", "Brand tone", "OOH & brand video"],
    href: "#expression",
  },
  {
    n: "4",
    name: "Brand Promise",
    sub: "Why believe us",
    question: "Why will users believe us?",
    bullets: ["Which products and features deliver on the promise?", "How do we communicate the USP?"],
    outputs: ["Product branding & USP", "2–3 year product & feature roadmap"],
    href: "#promise",
  },
];

const purposeRows = [
  {
    k: "Simple",
    pains: ["High investment minimums", "Priority-tier segmentation, not inclusive", "Long customer-service wait times", "Requires a branch visit"],
    fixes: ["Low investment minimum, from $1", "100% online self-serve account opening", "AI tools for instant help", "Mobile-first, available anytime"],
  },
  {
    k: "Reliable",
    pains: ["Hidden FX markups and transaction fees", "Below-minimum-balance and service fees"],
    fixes: ["Zero hidden fees, no account-maintenance fee", "Real-time, fully transparent exchange rates"],
  },
  {
    k: "Rewarding",
    pains: ["Delayed rewards", "Complex tiered perks by level and spend type", "Hard to reconcile manually"],
    fixes: ["One flat rate and perk, no conditions attached", "Daily interest, credited instantly", "Cashback on every transaction"],
  },
];

const segments = [
  { name: "Gen Alpha", range: "7–15", tag: "Secondary target", tone: "second", stage: "Learning & exploring: primary/secondary schoolers", needs: "Centered on conversational AI; money is a digital tool and game asset; small, parent-supervised autonomy", wants: "Learning, safety, gamified experience" },
  { name: "Gen Z", range: "16–28", tag: "Primary target", tone: "primary", stage: "Chasing independence: from college into first job and early career", needs: "Self-directed, peer-influenced; mobile-first, instant experience; wants simple, fast, always-improving", wants: "Simple, reliable, rewarding" },
  { name: "Millennials", range: "29–45", stage: "Building a life: mid-career", needs: "Habit-driven, values convenience; verifies products via trusted platforms and people; needs comprehensive products", wants: "Household finances, convenience" },
  { name: "Gen X", range: "46–60", stage: "Growing wealth: housing, kids' education, etc. stabilizing", needs: "Values tradition and reputation; experienced investors maximizing returns; wants bespoke, premium advice", wants: "Investing, retirement planning" },
  { name: "Boomers", range: "61+", stage: "Protecting wealth: retirement", needs: "Wants peace of mind, trust, and safety; more cautious with money; values human service", wants: "Safety, legacy planning" },
];

const whyGenZ = [
  { k: "A", title: "Lower switching friction", body: "Older users are loyal to their current bank, usually switching only after a bad experience." },
  { k: "B", title: "We can win", body: "MariBank delivers the mobile-first, instant banking experience Gen Z wants." },
  { k: "C", title: "Long-term value", body: "Winning a user at 20 means 20–30 years of runway." },
];

const rightToWin = [
  {
    k: "Simple",
    quote: "Help me get more without making me work for it.",
    have: ["Seamless: mobile-first, available anywhere", "Hassle-free: account opening is simple and direct, with friction removed along the way"],
    want: ["Interface: convenient, smooth, easy to use", "Onboarding & use: fewer frictions in everyday banking, simple flow"],
  },
  {
    k: "Reliable",
    quote: "I can fully trust the bank to be transparent to me.",
    have: ["Clear, competitive pricing: zero fees domestically and abroad, competitive FX", "AI-powered experience: an AI assistant in development for real-time support and advice"],
    want: ["Transparent: no hidden fees or fine print, rules explained upfront", "Stay informed: real-time visibility into account status and market trends"],
  },
  {
    k: "Rewarding",
    quote: "Every effort of mine pays off, when I achieve all the “adulthood” milestones.",
    have: ["Low barrier: rewards unlock easily, e.g. higher daily interest via ShopeeVIP", "Daily payout: savings accrue and show interest every day"],
    want: ["Low-barrier rewards: no unnecessary tiers or conditions — every action counts", "Instant feedback: instant, consistent rewards, no long wait"],
  },
];

const mindsetRows = [
  { k: "Life attitude", old: "“Work now, enjoy later”", genZ: "“Enjoy the moment, fully”" },
  { k: "Technology", old: "Useful, practical and reliable", genZ: "The default way of life — fast, personalized" },
  { k: "Rewards", old: "Chasing long-term value maximization", genZ: "Instant, visible gratification" },
  { k: "Relationship with money", old: "Needs careful management", genZ: "A tool that unlocks opportunity" },
  { k: "Trust", old: "Built on reputation and history", genZ: "Built on transparency and experience" },
  { k: "Learning & decisions", old: "Research, read, and ask first, then decide", genZ: "Learn from creators, content, and AI — decide instantly" },
];

const genZWants = [
  { title: "Simple / effortless", body: "An intuitive, frictionless, personalized experience", hot: true },
  { title: "Instant", body: "Real-time support, instant feedback, instant decisions" },
  { title: "In control", body: "Autonomy, visible progress, tangible rewards" },
];

const toneOfVoice = [
  { label: "Simple", title: "Clear, concise", quote: "That was easy.", bubbles: ["Done.", "You're all set.", "Money's in."] },
  { label: "Reliable", title: "Calm, confident", quote: "I don't have to worry.", bubbles: ["We'll notify you when it's complete.", "Your money is secure.", "We'll take care of the rest."] },
  { label: "Rewarding", title: "Valued, optimistic", body: "Rewards aren't just cashback — they make users feel like they're making a smart financial decision.", bubbles: ["Nice. You earned cashback.", "Your savings are growing.", "Every little bit adds up."] },
];

const brandOverview = [
  { label: "Overall tagline", value: "MariBank, Just Works" },
  { label: "Target audience", value: "Digital-native Gen Z (16–28)" },
  { label: "Brand position", value: "Simple, reliable, rewarding" },
  { label: "Emotional description", value: "Simple / effortless / frictionless" },
];

const promiseCards = [
  { label: "Mari Savings", title: "Savings", items: ["No-condition account opening, no minimum deposit", "Daily interest, visible every day", "Zero account-maintenance fee"] },
  { label: "Mari Credit Card", title: "Credit card", items: ["Uncapped cashback, no minimum spend", "Cashback on every transaction", "No complex tiered perks"] },
  { label: "Mari Invest", title: "Investing", items: ["Start from $1", "Presented by asset class and risk/return"] },
  { label: "Transfer & FX", title: "Transfer & FX", items: ["Real-time, transparent exchange rates", "No hidden FX markup"] },
];

const directions = [
  { tag: "Direction D", image: directionDImage },
  { tag: "Direction C", image: directionCImage },
  { tag: "Direction B", image: directionBImage },
  { tag: "Direction A", image: directionAImage },
];

const scenes = [
  { lean: "orange", title: "Approachable", context: "Acquisition ads, social media, inside Shopee", body: "Lower the distance, lift conversion." },
  { lean: "graphite", title: "Neutral, leaning steady", context: "In-product UI, statements, risk disclosures", body: "Trust first — clarity matters more than emotional expression." },
  { lean: "ink", title: "Leading", context: "Wealth & investing, outdoor ads, flagship campaigns", body: "Build a sense of expertise and quality." },
];

const stories = [
  { label: "Product benefit", line: "Daily interest", quote: "Wake up, and the interest is already in." },
  { label: "Product benefit", line: "Effortless investing", quote: "Give the time you’d spend researching the market back to your life.", note: "Paired with a risk disclosure" },
];

const lockedChips = ["Logo & signature-mark usage", "Primary color & ratio", "Typeface", "Grid & layout rules", "Photography principles", "Compliance placement & style"];
const flexibleChips = ["Secondary palette", "Lens choice", "Layout variation", "Scene & casting"];

const kbNodes = [
  { title: "Business knowledge", body: "Product, selling points, target audience" },
  { title: "Brand positioning", body: "Approachable / leading rules by scene" },
  { title: "Design system", body: "Component library" },
  { title: "Tone & voice", body: "Tone, wording, length" },
  { title: "Compliance rules", body: "Banned phrasing, required risk disclosures", hot: true },
  { title: "Visual asset library", body: "Signature mark, lens references, templates" },
];

const flowLanes = [
  {
    name: "Static banner & microsite",
    steps: [
      { phase: "Content", title: "Copy agent", body: "Generates copy within the tone & voice rules and length limits." },
      { phase: "Visual", title: "Key visual agent", body: "Generates visuals from the asset library, brand guideline, and prompt." },
      { phase: "Packaging", title: "Template agent", body: "Applies the asset template, design spec, and layout rules." },
    ],
  },
  {
    name: "Motion video",
    steps: [
      { phase: "Content", title: "Script agent", body: "Script and rough keyframes." },
      { phase: "Visual", title: "Video agent", body: "First-cut video." },
      { phase: "Packaging", title: "Packaging", body: "Voiceover and final mix." },
    ],
  },
];

const reviewCheckpoints = ["Input confirmed", "Key-visual review", "Compliance review", "Final review before launch"];

const works = [
  { tag: "Website", title: "Brand website", ratio: "21/9" },
  { tag: "Campaign", title: "Campaign pages & microsites", ratio: "4/3" },
  { tag: "Product", title: "Product UI", ratio: "4/3" },
  { tag: "OOH", title: "MariBank out-of-home ads", ratio: "21/9" },
];

const results = [
  { title: "Brand health", chips: ["Unaided awareness", "Trust & other brand attribute scores", "Consideration among non-Shopee users"] },
  { title: "Acquisition mix", chips: ["Non-Shopee channel share of new accounts", "21–30 share of new users"] },
  { title: "Production efficiency", chips: ["Asset turnaround time", "First-pass review rate", "Click-through rate"] },
];
---

<BaseLayout
  title="Tone — MariBank AI-Native Brand Creative & Visual Design System — Lin Hongyu"
  description="MariBank borrows Shopee's trust to win its first users, then needs to be remembered on its own once the business moves beyond Shopee — redefining the brand's meaning and handing its standard to a system where people define the rules and AI executes them."
>
  <div class="case-page">
    <!-- Hero -->
    <section class="section case-hero">
      <div class="wrap case-hero-center">
        <h1>MariBank AI-Native Brand, Creative &amp; Visual Design System</h1>
        <p class="case-subtitle">
          MariBank borrows Shopee's trust to win its first wave of
          users — then needs to be remembered on its own once the
          business moves beyond Shopee. We redefined what the brand
          means, built three distinctive brand assets, and handed the
          brand standard to a system where people define the rules
          and AI executes them.
        </p>
      </div>
      <div class="wrap">
        <div class="case-hero-banner-frame">
          <Image
            src={toneImage}
            alt="MariBank brand tone"
            widths={[800, 1200, 1600, 2000]}
            sizes="100vw"
            class="case-hero-banner-img"
          />
        </div>
      </div>
    </section>

    <!-- 01 Overview -->
    <section class="section case-chapter case-chapter--center" id="overview">
      <div class="wrap">
        <header class="sh">
          <p class="eyebrow"><span class="no">01</span>Overview</p>
          <h2>MariBank's brand needs to do two things at once</h2>
          <p class="sh-sub">Borrow Shopee's trust to win first users — then build an identity that stands on its own.</p>
        </header>
        <div class="focus3">
          {overviewCards.map((c) => (
            <div class="focus-card">
              <span class="ghost-n">{c.n}</span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 Brand element strategy -->
    <section class="section case-chapter case-chapter--alt case-chapter--center" id="system">
      <div class="wrap">
        <header class="sh">
          <p class="eyebrow"><span class="no">02</span>Brand element strategy</p>
          <h2>When the business needs users beyond Shopee, what makes the brand remembered on its own?</h2>
          <p class="sh-sub">Orange gives MariBank Shopee's trust by nature — and that's also the challenge. Our answer: split brand elements into two groups.</p>
        </header>
        <div class="groups">
          <div class="group group--keep">
            <span class="label">Keep the link</span>
            <div class="swatch"><i aria-hidden="true"></i><div><b>Color</b><p class="muted">MariBank orange</p></div></div>
            <p class="muted">Carries forward the trust and traffic Shopee brings.</p>
          </div>
          <div class="group group--own">
            <span class="label" style="color:rgba(255,255,255,.55)">Build independent recognition</span>
            <div class="owns">
              {ownedAssets.map((a) => (
                <div><span class="owns-mark" aria-hidden="true">{a.mark}</span><b>{a.title}</b><span>{a.sub}</span></div>
              ))}
            </div>
            <p style="color:rgba(255,255,255,.7)">The part the brand can take with it once it moves beyond Shopee.</p>
          </div>
        </div>
        <div class="weightbar">
          <span class="label">Weight shift</span>
          <div class="weightbar-bar" aria-hidden="true"></div>
          <div class="weightbar-ends"><span>Today: color carries most of the recognition</span><span>As the share of users from beyond Shopee grows, the owned assets carry more weight &rarr;</span></div>
        </div>
      </div>
    </section>

    <!-- 03 AI-native operating framework -->
    <section class="section case-chapter case-chapter--center" id="framework">
      <div class="wrap">
        <header class="sh">
          <p class="eyebrow"><span class="no">03</span>AI-native operating framework</p>
          <h2>People define the brand standard, the system executes it</h2>
        </header>
        <div class="layers" role="img" aria-label="Two-layer framework: the brand operating framework above is defined by people with AI assistance; the system execution logic below is executed by AI with human review at key checkpoints.">
          <div class="layer layer--top">
            <div class="layer-who"><span class="label">{frameworkTop.label}</span><h3>{frameworkTop.title}</h3><p class="muted">{frameworkTop.sub}</p></div>
            <div class="layer-steps">
              {frameworkTop.steps.map((s) => (
                <div class="layer-step">{s.title}<small>{s.sub}</small></div>
              ))}
            </div>
          </div>
          <div class="layer-between"><i aria-hidden="true"></i><span>Standards are written into the system</span><i aria-hidden="true"></i></div>
          <div class="layer layer--bottom">
            <div class="layer-who"><span class="label" style="color:rgba(255,255,255,.5)">{frameworkBottom.label}</span><h3>{frameworkBottom.title}</h3><p style="color:rgba(255,255,255,.65)">{frameworkBottom.sub}</p></div>
            <div class="layer-steps">
              {frameworkBottom.steps.map((s) => (
                <div class="layer-step layer-step--dark">{s.title}<small>{s.sub}</small></div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 04 Semantic layer -->
    <section class="section case-chapter case-chapter--alt case-chapter--center" id="semantic">
      <div class="wrap">
        <header class="sh">
          <p class="eyebrow"><span class="no">04</span>Semantic layer</p>
          <h2>From "Shopee's financial service" to "the bank for young people"</h2>
        </header>
        <div class="vs-grid">
          <div class="vs-side vs-side--old">
            <span class="vs-label">Stage 1 · How users saw us</span>
            <p class="vs-q">We're Shopee's financial service, backed by Sea — safe and reliable.</p>
            <div class="kv"><span class="label">Business strategy</span><p>As a 0-to-1 product, tying closely to Shopee was the fastest way to earn users' trust and traffic.</p></div>
          </div>
          <div class="vs-mid" aria-hidden="true">&rarr;</div>
          <div class="vs-side vs-side--new">
            <span class="vs-label">Stage 2 · How we define ourselves</span>
            <p class="vs-q">We're the bank for young people: we handle the complicated banking so you can focus on living.</p>
            <div class="kv"><span class="label" style="color:rgba(255,255,255,.6)">Business strategy</span><p style="color:rgba(255,255,255,.78)">Having built a base of users through Shopee, continued growth needs an independent brand identity that opens acquisition channels beyond Shopee.</p></div>
          </div>
        </div>
        <p class="sub-p" style="margin:var(--space-4) auto 0">Stage 2 breaks down into a top-down brand framework: a brand conversation starts with "why we exist" and "who we serve," before deciding the tagline and message. We used four questions to define the second stage's brand semantics, each with a clear output.</p>
        <div class="fw4">
          {frameworkNav.map((f) => (
            <a class="fw-card" href={f.href}>
              <div class="fw-card-head"><span>{f.n}</span>{f.name}<small>{f.sub}</small></div>
              <h4>{f.question}</h4>
              <ul>{f.bullets.map((b) => <li>{b}</li>)}</ul>
              <div class="fw-card-out"><span class="label">Output</span><div class="chips chips--sm">{f.outputs.map((o) => <span class="pill">{o}</span>)}</div></div>
            </a>
          ))}
        </div>

        <h3 class="sub-h" id="purpose"><span class="no">4.1</span>Brand Purpose: traditional banks' pain points are MariBank's opportunity</h3>
        <p class="sub-p">Across Simple, Reliable, and Rewarding, users keep feeling the pain points of traditional banks — and MariBank already has the products and capabilities to fix them.</p>
        <div class="scroll-x">
          <div class="pf-table">
            <div class="pf-head"><span></span><span>Traditional banks' pain points today</span><span></span><span>MariBank's products & capabilities</span></div>
            {purposeRows.map((r) => (
              <div class="pf-row">
                <div class="pf-k">{r.k}</div>
                <ul class="pf-pain">{r.pains.map((p) => <li>{p}</li>)}</ul>
                <div class="pf-arrow" aria-hidden="true">&rarr;</div>
                <ul class="pf-fix">{r.fixes.map((f) => <li>{f}</li>)}</ul>
              </div>
            ))}
          </div>
        </div>

        <h3 class="sub-h" id="positioning"><span class="no">4.2</span>Brand Positioning: anchoring on digital-native Gen Z, 16–28</h3>
        <p class="sub-p">Gen Z is willing to switch banks, lines up well with MariBank's strengths, and brings long-term value.</p>
        <div class="stats stats--two">
          {ageStats.map((s) => (
            <div class="stat"><span class="label">{s.label}</span><div class="stat-n">{s.value}</div></div>
          ))}
        </div>
        <div class="seg-wrap">
          <div class="scroll-x">
            <div class="segs">
              <div class="seg-head"><span>Audience</span><span>Life stage</span><span>Financial needs</span><span>Wants from a bank</span></div>
              {segments.map((s) => (
                <div class={`seg ${s.tone ? `seg--${s.tone}` : ""}`}>
                  <div class="seg-who"><b>{s.name}</b><small>{s.range}</small>{s.tag && <span class={`pill ${s.tone === "primary" ? "pill--accent" : "pill--tint"}`}>{s.tag}</span>}</div>
                  <p>{s.stage}</p>
                  <p>{s.needs}</p>
                  <p><b>{s.wants}</b></p>
                </div>
              ))}
            </div>
          </div>
          <aside class="why">
            <span class="label">Why Gen Z</span>
            {whyGenZ.map((w) => (
              <div><b>{w.k}</b><p><strong>{w.title}</strong>: {w.body}</p></div>
            ))}
          </aside>
        </div>
        <p class="note">The brand expresses a young attitude — it doesn't segment users by age. Users 40+ remain the main source of deposits; the brand shift can't make them feel left behind.</p>

        <h4 class="sub-h4">Right to win: MariBank's capabilities line up with what Gen Z expects</h4>
        <div class="scroll-x">
          <div class="rtw-table">
            <div class="rtw-head"><span></span><span>MariBank's existing reputation & capabilities</span><span>What Gen Z expects from a bank</span></div>
            {rightToWin.map((r) => (
              <div class="rtw-row">
                <div class="rtw-attr"><b>{r.k}</b><q>{r.quote}</q></div>
                <ul>{r.have.map((h) => { const [lead, ...rest] = h.split(": "); return <li><em>{lead}</em>{rest.join(": ")}</li>; })}</ul>
                <ul class="rtw-want">{r.want.map((w) => { const [lead, ...rest] = w.split(": "); return <li><em>{lead}</em>{rest.join(": ")}</li>; })}</ul>
              </div>
            ))}
          </div>
        </div>
        <p class="conclude">MariBank is best positioned to serve Gen Z with a "simple, reliable, rewarding" brand position.</p>

        <h3 class="sub-h" id="expression"><span class="no">4.3</span>Brand Expression: anchoring on "simple / effortless"</h3>
        <p class="sub-p">Gen Z wants life to be effortless, instant, and in their control. Of the three attributes, users most often associate MariBank with "simple" — so that's our anchor for brand expression.</p>
        <div class="mind-wrap">
          <div class="scroll-x">
            <div class="mindset">
              <div class="mindset-head"><span>Dimension</span><span>Older generations<small>Millennials · Gen X · Boomers</small></span><span>Gen Z<small>16–28</small></span></div>
              {mindsetRows.map((m) => (
                <div class="mindset-row"><b>{m.k}</b><span>{m.old}</span><span class="mindset-genz">{m.genZ}</span></div>
              ))}
            </div>
          </div>
          <aside class="wants">
            <span class="label">Gen Z wants life to be</span>
            {genZWants.map((w) => (
              <div class={w.hot ? "hot" : ""}><b>{w.title}</b><p>{w.body}</p></div>
            ))}
            <p class="anchor-note">Users most often associate MariBank with "simple," so we anchor brand expression there.</p>
          </aside>
        </div>

        <div class="tagline-block">
          <div class="tl-main">
            <span class="label">Brand tagline · consistent with the "simple/effortless" position</span>
            <p class="tl">MariBank, <span>Just Works</span></p>
            <blockquote>&ldquo;I don't have to think about it.&rdquo;</blockquote>
          </div>
          <div class="tl-emo">
            <span class="label">Brand emotion · validated with internal focus groups</span>
            <ul><li>Smooth, frictionless experience</li><li>Peace of mind and confidence</li><li>The bank quietly handles complexity behind the scenes</li></ul>
          </div>
        </div>
        <div class="bo">
          {brandOverview.map((b) => (
            <div><span>{b.label}</span><b>{b.value}</b></div>
          ))}
        </div>

        <h4 class="sub-h4">Tone of voice</h4>
        <div class="tov">
          {toneOfVoice.map((t) => (
            <div class="tv">
              <span class="label">{t.label}</span>
              <h4>{t.title}</h4>
              {t.quote ? <q>{t.quote}</q> : <p class="tv-p">{t.body}</p>}
              <div class="bubbles">{t.bubbles.map((b) => <span>{b}</span>)}</div>
            </div>
          ))}
        </div>

        <h4 class="sub-h4">Visual expression: approachable and leading</h4>
        <p class="sub-p" style="text-align:center;margin-bottom:var(--space-4)">We explored four visual directions for "young."</p>
        <div class="dir-spectrum" aria-hidden="true">
          <span class="dir-spectrum-label dir-spectrum-label--l">Fashion-forward and leading</span>
          <span class="dir-spectrum-arrow"></span>
          <span class="dir-spectrum-label dir-spectrum-label--r">Warm and approachable</span>
        </div>
        <div class="dirs">
          {directions.map((d) => (
            <div class="dir-frame">
              <Image src={d.image} alt={`${d.tag} mood board`} widths={[260, 320, 400]} sizes="(max-width: 700px) 22vw, 260px" class="dir-img" />
            </div>
          ))}
        </div>
        <div class="range">
          <p class="sub-p" style="margin-bottom:var(--space-3)">We didn't pick just one direction. MariBank needs to carry two attitudes at once: the approachability of "I'm one of you," and the leadership of "hand the complicated stuff to me." We defined a range between the two, and set rules for which end different situations lean toward.</p>
          <div class="axis" aria-hidden="true">
            <div class="axis-track"></div>
            <span class="axis-end axis-end--l">Approachable<small>I'm one of you</small></span>
            <span class="axis-end axis-end--r">Leading<small>Hand the complicated stuff to me</small></span>
            <span class="axis-dot" style="left:10%;border-color:var(--color-accent)"></span>
            <span class="axis-dot" style="left:50%;border-color:var(--color-ink-soft)"></span>
            <span class="axis-dot" style="left:90%;border-color:#f2b705"></span>
          </div>
          <div class="scenes">
            {scenes.map((s) => (
              <div class="scene">
                <div class="scene-lean"><i class={`scene-dot--${s.lean}`}></i>{s.title}</div>
                <h4>{s.context}</h4>
                <p class="muted">{s.body}</p>
              </div>
            ))}
          </div>
          <p class="muted" style="font-size:13px;margin-top:var(--space-2)">This rule table is also written into the brand knowledge base — AI picks the right expression for each scene when generating assets.</p>
        </div>

        <h3 class="sub-h" id="promise"><span class="no">4.4</span>Brand Promise: making the product deliver on "Just Works"</h3>
        <p class="sub-p">The brand promise ultimately has to be earned by the product. Each product line maps to a concrete set of selling points, told in the same voice.</p>
        <div class="promise-cards">
          {promiseCards.map((p) => (
            <div class="pr"><span class="label">{p.label}</span><h4>{p.title}</h4><ul>{p.items.map((i) => <li>{i}</li>)}</ul></div>
          ))}
        </div>
        <PlaceholderImage ratio="21/9" radius="20px" label="2–3 year product & feature roadmap" />
      </div>
    </section>

    <!-- 05 Memory -->
    <section class="section case-chapter case-chapter--dark" id="memory">
      <div class="wrap">
        <header class="sh">
          <p class="eyebrow"><span class="no">05</span>Memory: how users remember us</p>
          <h2>Distinctive brand assets, used consistently</h2>
          <p class="sh-sub" style="color:rgba(255,255,255,.65)">Building on Byron Sharp's idea of Distinctive Brand Assets, we built three memory anchors for MariBank.</p>
        </header>

        <div class="jw">
          <img class="jw-mark" src="/images/just-works-logo.png" alt="MariBank's &quot;Just Works&quot; signature mark" />
          <div>
            <span class="label" style="color:var(--color-accent)">Memory anchor 1 · Signature mark</span>
            <h3 style="font-size:26px;margin-top:8px">The handwritten mark "Just Works"</h3>
            <p class="sub-p" style="color:rgba(255,255,255,.75);margin-top:12px">The brand tagline "MariBank, Just Works" is distilled into a handwritten signature mark. The script represents youthful, driven energy; "Just Works" comes from "it just works" — banking should be as effortless and reliable as a tool that simply works, so users "don't have to think about it."</p>
            <div class="rules">
              <div><b>01</b><span>Set a minimum size so it stays legible.</span></div>
              <div><b>02</b><span>The script is only used for the mark itself — body copy uses the standard typeface.</span></div>
            </div>
          </div>
        </div>
        <div class="gallery gallery--3" style="margin-top:var(--space-4)">
          <PlaceholderImage ratio="1/1" radius="14px" label="Just Works icon" />
          <PlaceholderImage ratio="1/1" radius="14px" label="Applied example" />
          <PlaceholderImage ratio="1/1" radius="14px" label="Applied example" />
        </div>

        <h3 class="sub-h" style="color:#fff"><span class="no">2</span>Lens: a point of view that's ours</h3>
        <p class="sub-p" style="color:rgba(255,255,255,.75)">A distinctive shooting angle paired with the signature mark brings a youthful energy and impact.</p>
        <div class="gallery gallery--3">
          <figure><PlaceholderImage ratio="4/5" radius="14px" label="Angle" /><figcaption>Angle</figcaption></figure>
          <figure><PlaceholderImage ratio="4/5" radius="14px" label="Framing" /><figcaption>Framing</figcaption></figure>
          <figure><PlaceholderImage ratio="4/5" radius="14px" label="Composition" /><figcaption>Composition</figcaption></figure>
        </div>

        <h3 class="sub-h" style="color:#fff"><span class="no">3</span>Storytelling</h3>
        <p class="sub-p" style="color:rgba(255,255,255,.75)">A number is cold; a story or an attitude toward life is what gets remembered and shared. We turn product selling points into everyday scenes.</p>
        <div class="stories">
          {stories.map((s) => (
            <div class="story story--dark">
              <div class="story-copy">
                <span class="label" style="color:rgba(255,255,255,.55)">{s.label}</span>
                <h4 class="muted" style="color:rgba(255,255,255,.65)">{s.line}</h4>
                <p class="story-quote">{s.quote}</p>
                {s.note && <small class="muted" style="color:rgba(255,255,255,.5)">{s.note}</small>}
              </div>
              <PlaceholderImage ratio="16/9" radius="14px" label={`${s.line} key visual`} />
            </div>
          ))}
        </div>

        <h3 class="sub-h" style="color:#fff"><span class="no">4</span>How the assets work together</h3>
        <p class="sub-p" style="color:rgba(255,255,255,.75)">The flagship brand carries emotion and attitude; individual products use concrete stories to carry the selling point. Mix the mark, the lens, and storytelling with intention — leave room to breathe, and don't stack every element onto one piece.</p>
        <div class="gallery gallery--4">
          <PlaceholderImage ratio="4/5" radius="14px" label="Flagship material" />
          <PlaceholderImage ratio="4/5" radius="14px" label="Flagship material" />
          <PlaceholderImage ratio="4/5" radius="14px" label="Product material" />
          <PlaceholderImage ratio="4/5" radius="14px" label="Product material" />
        </div>
      </div>
    </section>

    <!-- 06 Visual parameters -->
    <section class="section case-chapter case-chapter--center" id="params">
      <div class="wrap">
        <header class="sh">
          <p class="eyebrow"><span class="no">06</span>Visual parameter layer</p>
          <h2>Locked and flexible: part of the system repeats until it's remembered, part stays open for creativity</h2>
        </header>
        <div class="lockflex">
          <div class="lf lf--lock">
            <h3>Locked</h3><span class="muted" style="color:rgba(255,255,255,.6)">Guarantees brand unity</span>
            <div class="chips">{lockedChips.map((c) => <span class="pill pill--dark">{c}</span>)}</div>
          </div>
          <div class="lf lf--flex">
            <h3>Flexible</h3><span class="muted">Keeps room for creativity</span>
            <div class="chips">{flexibleChips.map((c) => <span class="pill">{c}</span>)}</div>
          </div>
        </div>
        <PlaceholderImage ratio="21/9" radius="20px" label="Visual parameter guideline overview" />
      </div>
    </section>

    <!-- 07 AI-native execution -->
    <section class="section case-chapter case-chapter--alt case-chapter--center" id="ai">
      <div class="wrap">
        <header class="sh">
          <p class="eyebrow"><span class="no">07</span>AI-native execution</p>
          <h2>People define the standard, the system executes it</h2>
          <p class="sh-sub">This case focuses on how the brand standard gets defined and handed to AI to execute; the infrastructure and process changes sit in the Platform case.</p>
        </header>

        <h3 class="sub-h" style="margin-top:0"><span class="no">1</span>Knowledge base: single source of truth</h3>
        <div class="kb">
          <div class="kb-core">Brand knowledge base<small>Single source of truth</small></div>
          <div class="kb-grid">
            {kbNodes.map((n) => (
              <div class={`kb-node ${n.hot ? "kb-node--hot" : ""}`}><b>{n.title}</b><span>{n.body}</span></div>
            ))}
          </div>
        </div>
        <div class="gallery gallery--4" style="margin-top:var(--space-3)">
          <PlaceholderImage ratio="4/3" radius="14px" label="Knowledge base screenshot" />
          <PlaceholderImage ratio="4/3" radius="14px" label="Knowledge base screenshot" />
          <PlaceholderImage ratio="4/3" radius="14px" label="Knowledge base screenshot" />
          <PlaceholderImage ratio="4/3" radius="14px" label="Knowledge base screenshot" />
        </div>

        <h3 class="sub-h"><span class="no">2</span>Multi-agent pipeline, with human review checkpoints</h3>
        <p class="sub-p">Generates standardized brand operating assets (banners, microsites, online &amp; offline marketing material, short video) from the knowledge base, then hands off to the backend for publishing.</p>
        <div class="flow">
          <div class="flow-input"><b>Input · Google Sheet</b><span class="muted">Marketing fills in campaign rules, key selling points, and target metrics.</span></div>
          {flowLanes.map((lane) => (
            <div class="flow-lane">
              <span class="flow-lane-name">{lane.name}</span>
              <div class="flow-steps">
                {lane.steps.map((s) => (
                  <div class="flow-step"><span class="flow-step-phase">{s.phase}</span><b>{s.title}</b><p>{s.body}</p></div>
                ))}
              </div>
            </div>
          ))}
          <div class="flow-review"><b>Review &amp; launch</b><span class="muted">Creative review, compliance review, then handed to the backend to publish.</span></div>
        </div>
        <div class="legend">
          {reviewCheckpoints.map((c) => <span class="pill pill--accent">{c}</span>)}
        </div>

        <h3 class="sub-h"><span class="no">3</span>Principles for AI-generated people</h3>
        <PlaceholderImage ratio="21/9" radius="20px" label="Principles for AI-generated people (full diagram)" />
      </div>
    </section>

    <!-- 08 Works -->
