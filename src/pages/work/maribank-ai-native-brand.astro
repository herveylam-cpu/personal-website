    width: 2px;
    height: 24px;
    background: var(--color-line);
    display: block;
  }

  /* 04 Semantic layer — vs-grid is already a light/arrow/dark recipe,
     reused for the positioning shift and the age-shift comparison. */
  .vs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: stretch;
    text-align: left;
  }

  .vs-side {
    border-radius: 20px;
    padding: var(--space-3);
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .vs-side--old {
    background: rgba(23, 20, 15, 0.04);
  }

  .vs-side--new {
    background: var(--color-ink);
    color: #fff;
  }

  .vs-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    font-weight: 600;
  }

  .vs-side--new .vs-label {
    color: rgba(255, 255, 255, 0.6);
  }

  .vs-q {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.4;
  }

  .vs-mid {
    display: grid;
    place-content: center;
    font-weight: 300;
    font-size: 32px;
    color: var(--color-ink-faint);
  }

  .kv p {
    font-size: 14px;
    margin-top: 4px;
    color: var(--color-ink-soft);
  }

  .qnav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: var(--space-2);
  }

  .qnav .pill:hover {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #fff;
  }

  .shift {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: var(--space-3);
    align-items: stretch;
    text-align: left;
  }

  .stats {
    display: grid;
    gap: var(--space-2);
  }

  .stat {
    background: rgba(23, 20, 15, 0.04);
    border-radius: 20px;
    padding: var(--space-3);
    display: grid;
    gap: 6px;
  }

  .stat-n {
    font-weight: 200;
    font-size: 40px;
    line-height: 1;
  }

  .ages {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-2);
    align-items: center;
  }

  .age {
    border-radius: 20px;
    padding: var(--space-3);
    display: grid;
    gap: 10px;
    align-content: start;
    height: 100%;
  }

  .age--old {
    background: rgba(23, 20, 15, 0.04);
  }

  .age--young {
    background: var(--color-ink);
    color: #fff;
  }

  .age h3 {
    font-size: 19px;
  }

  .age p {
    font-size: 14px;
    color: var(--color-ink-soft);
  }

  .dirs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .dir-frame {
    position: relative;
    aspect-ratio: 1425 / 2000;
    border-radius: 14px;
    overflow: hidden;
  }

  .dir-frame :global(.dir-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .dir-spectrum {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .dir-spectrum-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink-soft);
    white-space: nowrap;
  }

  .dir-spectrum-label--l {
    color: #c98b00;
  }

  .dir-spectrum-label--r {
    color: var(--color-accent);
  }

  .dir-spectrum-arrow {
    flex: 1;
    height: 2px;
    min-width: 40px;
    background: linear-gradient(90deg, #f2b705, var(--color-accent));
    position: relative;
  }

  .dir-spectrum-arrow::after {
    content: "";
    position: absolute;
    right: -1px;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 7px solid var(--color-accent);
  }

  .range {
    margin-top: var(--space-5);
    background: rgba(23, 20, 15, 0.04);
    border-radius: 20px;
    padding: var(--space-4);
    text-align: left;
  }

  .axis {
    position: relative;
    height: 80px;
    margin: 0 0 var(--space-3);
  }

  .axis-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 50px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-ink-soft) 50%, #f2b705);
  }

  .axis-end {
    position: absolute;
    top: 0;
    font-weight: 900;
    font-size: 18px;
  }

  .axis-end--l {
    left: 0;
    text-align: left;
  }

  .axis-end--r {
    right: 0;
    text-align: right;
  }

  .axis-end small {
    display: block;
    font-weight: 400;
    font-size: 12px;
    color: var(--color-ink-faint);
    white-space: nowrap;
    margin-top: 2px;
  }

  .axis-dot {
    position: absolute;
    top: 43px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 4px solid var(--color-ink);
    transform: translateX(-50%);
  }

  .scenes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .scene {
    background: var(--color-bg);
    border-radius: 14px;
    padding: var(--space-2);
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .scene-lean {
    display: flex;
    gap: 8px;
    align-items: center;
    font-weight: 700;
    font-size: 14px;
  }

  .scene-lean i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .scene-dot--orange {
    background: var(--color-accent);
  }

  .scene-dot--graphite {
    background: var(--color-ink-soft);
  }

  .scene-dot--ink {
    background: var(--color-ink);
  }

  .scene h4 {
    font-size: 14px;
    font-weight: 600;
  }

  .scene p {
    font-size: 13px;
  }

  /* Brand framework additions */
  .scroll-x {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .pill--tint {
    background: rgba(23, 20, 15, 0.06);
    border-color: transparent;
  }

  .fw4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
    text-align: left;
  }

  .fw-card {
    background: rgba(23, 20, 15, 0.04);
    border-radius: 18px;
    overflow: hidden;
    display: grid;
    gap: 12px;
    padding-bottom: var(--space-2);
    color: inherit;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .fw-card:hover {
    transform: translateY(-3px);
  }

  .fw-card-head {
    background: var(--color-ink);
    color: #fff;
    padding: var(--space-2);
    display: flex;
    gap: 10px;
    align-items: baseline;
    flex-wrap: wrap;
    font-weight: 700;
  }

  .fw-card-head span {
    color: var(--color-accent);
    font-style: italic;
  }

  .fw-card-head small {
    font-weight: 400;
    font-size: 12px;
    opacity: 0.7;
  }

  .fw-card h4 {
    padding: 0 var(--space-2);
    font-size: 16px;
    line-height: 1.4;
  }

  .fw-card ul {
    margin: 0;
    padding: 0 var(--space-2) 0 calc(var(--space-2) + 14px);
    font-size: 13px;
    color: var(--color-ink-soft);
    display: grid;
    gap: 4px;
  }

  .fw-card-out {
    margin: 0 var(--space-2);
    border-top: 1px dashed var(--color-line);
    padding-top: 10px;
    display: grid;
    gap: 8px;
  }

  .pf-table {
    display: grid;
    min-width: 760px;
  }

  .pf-head,
  .pf-row {
    display: grid;
    grid-template-columns: 8em minmax(0, 1fr) 40px minmax(0, 1fr);
    gap: var(--space-2);
    align-items: start;
  }

  .pf-head {
    font-weight: 700;
    font-size: 14px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--color-ink);
  }

  .pf-row {
    padding: var(--space-3) 0;
    border-bottom: 1px dashed var(--color-line);
  }

  .pf-k {
    font-weight: 700;
    font-size: 18px;
  }

  .pf-table ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    font-size: 14px;
  }

  .pf-pain li {
    color: var(--color-ink-faint);
    display: flex;
    gap: 8px;
  }

  .pf-pain li::before {
    content: "\2715";
    font-size: 11px;
    flex: none;
    margin-top: 3px;
  }

  .pf-fix li {
    display: flex;
    gap: 8px;
  }

  .pf-fix li::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    flex: none;
    margin-top: 6px;
  }

  .pf-arrow {
    text-align: center;
    color: var(--color-accent);
    font-weight: 300;
    font-size: 20px;
  }

  .stats--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: var(--space-3);
  }

  .seg-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: var(--space-3);
    align-items: start;
    text-align: left;
  }

  .segs {
    display: grid;
    gap: 8px;
    min-width: 720px;
  }

  .seg-head,
  .seg {
    display: grid;
    grid-template-columns: 9em minmax(0, 1fr) minmax(0, 1.3fr) minmax(0, 0.9fr);
    gap: var(--space-2);
    align-items: center;
  }

  .seg-head {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    padding: 0 var(--space-2) 6px;
  }

  .seg {
    background: rgba(23, 20, 15, 0.04);
    border-radius: 14px;
    padding: var(--space-2);
    font-size: 13px;
    line-height: 1.5;
  }

  .seg p {
    margin: 0;
  }

  .seg-who {
    display: grid;
    gap: 4px;
    justify-items: start;
  }

  .seg-who b {
    font-size: 17px;
  }

  .seg-who small {
    color: var(--color-ink-faint);
    font-size: 12px;
  }

  .seg--primary {
    background: var(--color-ink);
    color: #fff;
    padding-block: var(--space-2);
  }

  .seg--primary .seg-who small {
    color: rgba(255, 255, 255, 0.6);
  }

  .seg--primary p {
    color: rgba(255, 255, 255, 0.85);
  }

  .seg--second {
    background: var(--color-accent-soft);
  }

  .seg:not(.seg--primary):not(.seg--second) {
    opacity: 0.72;
  }

  .why {
    background: rgba(23, 20, 15, 0.04);
    border-radius: 20px;
    padding: var(--space-3);
    display: grid;
    gap: var(--space-2);
  }

  .why > div {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 10px;
    font-size: 13px;
    line-height: 1.6;
  }

  .why b {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1.5px solid var(--color-accent);
    color: var(--color-accent);
    display: grid;
    place-content: center;
    font-size: 12px;
  }

  .why strong {
    font-weight: 700;
  }

  .rtw-table {
    display: grid;
    gap: 10px;
    min-width: 760px;
  }

  .rtw-head,
  .rtw-row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr) minmax(0, 1.1fr);
    gap: var(--space-2);
  }

  .rtw-head {
    font-weight: 700;
    font-size: 13px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-ink);
  }

  .rtw-row > div,
  .rtw-row > ul {
    background: rgba(23, 20, 15, 0.04);
    border-radius: 14px;
    padding: var(--space-2);
    display: grid;
    gap: 10px;
    align-content: start;
    font-size: 13px;
    line-height: 1.5;
    margin: 0;
    list-style: none;
  }

  .rtw-attr {
    background: var(--color-ink);
    color: #fff;
  }

  .rtw-attr b {
    font-size: 19px;
  }

  .rtw-attr q {
    font-style: italic;
    color: rgba(255, 255, 255, 0.75);
    quotes: "\201C" "\201D";
  }

  .rtw-table em {
    font-style: normal;
    font-weight: 700;
    display: block;
    color: var(--color-ink);
  }

  .rtw-want em {
    color: var(--color-accent);
  }

  .conclude {
    margin-top: var(--space-2);
    background: var(--color-accent-soft);
    border-radius: 14px;
    padding: var(--space-2) var(--space-3);
    font-weight: 700;
    color: var(--color-accent);
  }

  .mind-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-3);
    align-items: stretch;
    text-align: left;
  }

  .mindset {
    display: grid;
    min-width: 560px;
  }

  .mindset-head,
  .mindset-row {
    display: grid;
    grid-template-columns: 9em minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-2);
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 13px;
    align-items: start;
  }

  .mindset-head {
    font-weight: 700;
    font-size: 14px;
    border-bottom: 2px solid var(--color-ink);
  }

  .mindset-head small {
    display: block;
    font-weight: 400;
    color: var(--color-ink-faint);
    font-size: 11px;
  }

  .mindset-row b {
    font-weight: 600;
  }

  .mindset-genz,
  .mindset-head span:last-child {
    background: var(--color-accent-soft);
    margin: -12px 0;
    padding: 12px 10px;
  }

  .wants {
    background: var(--color-ink);
    color: #fff;
    border-radius: 20px;
    padding: var(--space-3);
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .wants .label {
    color: rgba(255, 255, 255, 0.55);
  }

  .wants > div {
    border-top: 1px solid #2e3036;
    padding-top: 10px;
    display: grid;
    gap: 4px;
  }

  .wants > div:first-of-type {
    border-top: none;
    padding-top: 0;
  }

  .wants b {
    font-size: 16px;
  }

  .wants p {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
  }

  .wants .hot b {
    color: var(--color-accent);
  }

  .anchor-note {
    margin-top: 4px;
    border: 1px solid var(--color-accent);
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .tagline-block {
    margin-top: var(--space-4);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    border-radius: 20px;
    overflow: hidden;
    background: var(--color-ink);
    color: #fff;
    text-align: left;
  }

  .tl-main {
    padding: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }

  .tl-main .label,
  .tl-emo .label {
    color: rgba(255, 255, 255, 0.55);
  }

  .tl {
    font-weight: 200;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.1;
  }

  .tl span {
    color: var(--color-accent);
    font-weight: 700;
  }

  .tagline-block blockquote {
    margin: 0;
    border-left: 3px solid var(--color-accent);
    padding-left: 14px;
    font-style: italic;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.85);
  }

  .tl-emo {
    background: #1c1d21;
    padding: var(--space-4) var(--space-3);
    display: grid;
    gap: 12px;
    align-content: center;
  }

  .tl-emo ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    font-size: 14px;
  }

  .tl-emo li {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .tl-emo li::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    flex: none;
  }

  .bo {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-2);
    text-align: left;
  }

  .bo > div {
    background: rgba(23, 20, 15, 0.04);
    border-radius: 14px;
    padding: var(--space-2);
    display: grid;
    gap: 6px;
  }

  .bo span {
    font-size: 11px;
    color: var(--color-ink-faint);
    letter-spacing: 0.06em;
  }

  .bo b {
    font-size: 15px;
    line-height: 1.4;
  }

  .tov {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    text-align: left;
  }

  .tv {
    border: 1px solid var(--color-line);
    border-top: 4px solid var(--color-ink);
    border-radius: 18px;
    padding: var(--space-3);
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .tv h4 {
    font-size: 18px;
  }

  .tv q {
    font-size: 17px;
    font-style: italic;
    quotes: "\201C" "\201D";
  }

  .tv-p {
    font-size: 14px;
    color: var(--color-ink-soft);
  }

  .bubbles {
    display: grid;
    gap: 8px;
    justify-items: start;
    margin-top: 4px;
  }

  .bubbles span {
    background: rgba(23, 20, 15, 0.04);
    border-radius: 14px 14px 14px 4px;
    padding: 7px 12px;
    font-size: 13px;
  }

  .promise-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
    text-align: left;
  }

  .pr {
    background: rgba(23, 20, 15, 0.04);
    border-top: 4px solid var(--color-accent);
    border-radius: 18px;
    padding: var(--space-2);
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .pr h4 {
    font-size: 17px;
  }

  .pr ul {
    margin: 0;
    padding-left: 16px;
    font-size: 13px;
    color: var(--color-ink-soft);
    display: grid;
    gap: 4px;
  }

  /* 05 Memory (dark band) */
  .jw {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-4);
    align-items: center;
    text-align: left;
  }

  .jw-mark {
    width: 100%;
    max-width: 360px;
    height: auto;
    display: block;
  }

  .rules {
    display: grid;
    gap: 10px;
    margin-top: var(--space-2);
  }

  .rules div {
    display: grid;
    grid-template-columns: 2.5em minmax(0, 1fr);
    gap: 8px;
    border-top: 1px solid #2e3036;
    padding-top: 10px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.82);
  }

  .rules b {
    color: var(--color-accent);
    font-weight: 700;
  }

  .stories {
    display: grid;
    gap: var(--space-2);
  }

  .story {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-3);
    align-items: center;
    border-radius: 20px;
    padding: var(--space-3);
    text-align: left;
  }

  .story--dark {
    background: #1c1d21;
  }

  .story-copy {
    display: grid;
    gap: 6px;
  }

  .story-quote {
    font-size: clamp(19px, 2.4vw, 24px);
    font-weight: 700;
    line-height: 1.4;
    color: #fff;
  }

  /* 06 Visual parameters */
  .lockflex {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    text-align: left;
  }

  .lf {
    border-radius: 20px;
    padding: var(--space-3);
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .lf--lock {
    background: var(--color-ink);
    color: #fff;
  }

  .lf--flex {
    background: rgba(23, 20, 15, 0.04);
  }

  .lf h3 {
    font-size: 20px;
  }

  /* 07 AI-native execution */
  .kb {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
  }

  .kb-core {
    background: var(--color-ink);
    color: #fff;
