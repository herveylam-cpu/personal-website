    <!-- Next project -->
    <section class="section case-next">
      <div class="wrap">
        <a class="next-card" href="/work/maribank-homepage-redesign">
          <p class="next-card-label">Next project</p>
          <p class="next-card-title">Design — Maribank Homepage Redesign: Simplicity Is the Ultimate Sophistication</p>
          <span class="next-card-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* This page swaps the site's muted terracotta accent for the same
     brighter brand orange used on the Strategy case, scoped locally
     so every other page keeps the global --color-accent. */
  .case-page {
    --color-accent: #ff6000;
    --color-accent-soft: rgba(255, 96, 0, 0.1);
  }

  /* Hero */
  .case-hero {
    padding-top: var(--space-5);
  }

  .case-hero-center {
    text-align: center;
  }

  .case-hero h1 {
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(28px, 4.4vw, 46px);
    line-height: 1.15;
  }

  .case-subtitle {
    font-size: clamp(14px, 1.5vw, 16px);
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin-top: var(--space-3);
  }

  .case-hero-banner-frame {
    position: relative;
    aspect-ratio: 21 / 9;
    border-radius: 28px;
    overflow: hidden;
    margin-top: var(--space-5);
  }

  .case-hero-banner-frame :global(.case-hero-banner-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Chapter shell */
  .case-chapter--alt {
    background: rgba(23, 20, 15, 0.025);
  }

  .case-chapter--dark {
    background: var(--color-ink);
    color: #fff;
  }

  .case-chapter--center .sh {
    text-align: center;
  }

  .case-chapter--center .sh h2 {
    margin-inline: auto;
  }

  .sh {
    margin-bottom: var(--space-4);
  }

  .sh .no {
    font-style: italic;
    font-weight: 600;
    color: var(--color-accent);
    margin-right: 8px;
  }

  .case-chapter--dark .eyebrow {
    color: rgba(255, 255, 255, 0.6);
  }

  .sh h2 {
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.35;
    max-width: 26em;
    margin-top: 10px;
  }

  /* Where a section header has a sh-sub, flip the visual hierarchy:
     the sh-sub (often the fuller, more substantive sentence here)
     reads as the headline, and the h2 above it reads as a lead-in
     line. Sections with no sh-sub keep the plain h2 styling above. */
  .sh:has(.sh-sub) h2 {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-ink-soft);
    max-width: 38em;
  }

  .case-chapter--dark .sh:has(.sh-sub) h2 {
    color: rgba(255, 255, 255, 0.6);
  }

  .sh-sub {
    font-size: 16px;
    color: var(--color-ink-soft);
    max-width: 38em;
    margin-top: var(--space-2);
  }

  .sh:has(.sh-sub) .sh-sub {
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-ink);
    max-width: 26em;
  }

  .case-chapter--center .sh-sub {
    margin-inline: auto;
  }

  .sub-p {
    color: var(--color-ink-soft);
    font-size: 16px;
    max-width: 44em;
    margin-inline: auto;
  }

  .case-chapter--dark .sub-p {
    color: rgba(255, 255, 255, 0.75);
  }

  .sub-h {
    font-size: 21px;
    margin: var(--space-5) 0 var(--space-2);
    display: flex;
    gap: 10px;
    align-items: baseline;
    justify-content: center;
  }

  .sub-h .no {
    font-weight: 600;
    color: var(--color-accent);
  }

