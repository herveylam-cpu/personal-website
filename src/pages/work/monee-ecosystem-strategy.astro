<script>
  // Scroll-spy for the desktop TOC: whichever chapter is most in view
  // gets the highlighted link. IntersectionObserver rather than the
  // scroll-position math used elsewhere on the site — this only needs
  // "which section is current", not a continuous progress value, so
  // the browser-native observer is the simpler tool for the job.
  function setupCaseToc() {
    const links = document.querySelectorAll<HTMLAnchorElement>(
      "[data-toc-link]"
    );
    const chapters = document.querySelectorAll<HTMLElement>(".case-chapter");
    if (links.length === 0 || chapters.length === 0) return;

    const linkById = new Map<string, HTMLAnchorElement>();
    links.forEach((link) => {
      const id = link.dataset.tocLink;
      if (id) linkById.set(id, link);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const link = linkById.get(entry.target.id);
            if (!link) continue;
            links.forEach((l) => l.classList.remove("is-active"));
            link.classList.add("is-active");
          }
        }
      },
      { rootMargin: "-110px 0px -70% 0px" }
    );
    chapters.forEach((chapter) => observer.observe(chapter));

    const mobileSelect = document.querySelector<HTMLSelectElement>(
      ".case-toc-mobile"
    );
    mobileSelect?.addEventListener("change", () => {
      const target = mobileSelect.value;
      if (!target) return;
      document.querySelector(target)?.scrollIntoView({ behavior: "smooth" });
    });
  }

  // Tap-to-toggle for the ecosystem map nodes, so the detail reveal
  // (CSS :hover/:focus-visible) also works on touch devices that have
  // no real hover state.
  function setupEcoNodes() {
    const nodes = document.querySelectorAll<HTMLButtonElement>(".eco-node");
    nodes.forEach((node) => {
      node.addEventListener("click", () => {
        const wasOpen = node.classList.contains("is-open");
        nodes.forEach((n) => n.classList.remove("is-open"));
        if (!wasOpen) node.classList.add("is-open");
      });
    });
  }

  setupCaseToc();
  setupEcoNodes();
</script>
