---
// Strategy case study — rebuilt from "Lin_Hongyu_Design_Memo_v2"
// (Google Doc), which supersedes the earlier spec this page was
// first built from. English copy throughout, translated from the
// (mostly Chinese) doc to match the rest of the site's language.
// Doc passages the author highlighted yellow — meaning "show this
// visually, not as a table" — are called out in comments below each
// one, next to the visual that replaced the plain text/table.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderImage from "../../components/PlaceholderImage.astro";

const whoWeServe = [
  {
    title: "The financially underserved",
    flags: "🇮🇩 🇵🇭 🇻🇳 🇧🇷",
    markets: "Indonesia, Philippines, Vietnam, Brazil",
    traits:
      "Few assets, limited financial literacy — many get their first line of credit and their first account through Shopee.",
    focus:
      "Lower the barrier to understanding, build first-time trust, help users form healthy credit habits.",
  },
  {
    title: "Overlooked by experience and value",
    flags: "🇸🇬 🇲🇾 🇹🇭",
    markets: "Urban users in Singapore, Malaysia, Thailand",
    traits:
      "Already banked, but excluded by high thresholds, bundling, and cold experiences.",
    focus:
      "Win users from traditional banks with unconditional, transparent value and a better experience.",
  },
];

const phases = [
  {
    tag: "Phase 1",
    title: "Payments for games & e-commerce",
  },
  {
    tag: "Phase 2",
    title: "A financial matrix inside Shopee",
    body: "Used Shopee's traffic to serve buyers and sellers: payment, loan, banking and digital services.",
  },
  {
    tag: "Phase 3",
    title: "An independent financial ecosystem",
    body: "Grow beyond Shopee through ShopeePay and digital banks, and serve more underserved users.",
  },
];

const strategyPriorities = [
  {
    n: "01",
    title: "Segment by market",
    body: "Plan the exit from Shopee by market type, not a single path.",
  },
  {
    n: "02",
    title: "Trust first",
    body: "Put trust first among experience principles, with a clear trade-off rule between growth and responsible finance.",
  },
  {
    n: "03",
    title: "Clear, measurable roles",
    body: "Define a clear role, core metrics, and design levers for every product in the ecosystem, so design's contribution can be measured.",
  },
];

const ecosystemNodes = [
  {
    name: "ShopeePay",
    includes: "E-wallet, in/out-of-app payment, QR scan, bill payment",
    role: "Traffic gateway — captures Shopee's traffic and distributes it to other financial products",
    metrics: "Payment penetration, MAU, cross-sell conversion",
  },
  {
    name: "SPayLater & Credit",
    includes: "Buy-now-pay-later, cash loans, seller financing",
    role: "Revenue engine — Monee's main source of revenue and profit",
    metrics: "Credit-to-first-use conversion, GMV penetration, on-time repayment rate",
  },
  {
    name: "Digital Bank",
    includes: "MariBank (Singapore), SeaBank (Indonesia, Philippines): savings, fixed deposits, credit cards, cash loans",
    role: "Long-term growth engine — converts traffic into high-value, loyal users with low-cost funding",
    metrics: "Deposit balance, products per household, primary-bank metrics",
  },
  {
    name: "Investment",
    includes: "Mari Invest funds, stock trading, gold",
    role: "Attracts wealthier users and deepens asset retention",
    metrics: "AUM, investor conversion rate",
  },
  {
    name: "Insurance",
    includes: "Product protection, digital product insurance",
    role: "Supplementary coverage in transaction moments that lifts order value",
    metrics: "Attach rate, claims satisfaction",
  },
];

const marketRows = [
  {
    group: "Licensed markets",
    markets: "Singapore, Indonesia, Philippines",
    vehicle: "Digital bank",
    focus: "Capture deposits, move from secondary to primary bank, cross-sell",
  },
  {
    group: "Wallet + credit",
    markets: "Malaysia, Thailand, Vietnam, Brazil",
    vehicle: "ShopeePay app, off-platform SPayLater",
    focus: "Expand into offline & off-platform payments, build an off-platform credit experience",
  },
];

const principles = [
  {
    title: "Reliable",
    body: "Security and trust matter most in a financial product — the safety of funds, transparent information, anti-fraud protection, and staying dependable when something goes wrong.",
  },
  {
    title: "Simple",
    body: "Financial products often feel expert, complex, and distant. The brand should be approachable and the experience easy to understand — users can describe what each product does in one sentence.",
  },
  {
    title: "Rewarding",
    body: "Deliver real value: solve real needs around saving, borrowing, transferring, investing, and insuring — or offer competitive products and rewards.",
  },
];

const mariBankStages = [
  {
    stage: "Secondary bank",
    status: "Parks spare cash in MariBank, enjoys Shopee-linked perks",
    milestone: "Account opening, first deposit, first cross-sell",
  },
  {
    stage: "Scenario of choice",
    status: "Picks MariBank first for specific spending or investing scenarios",
    milestone: "Credit card becomes a daily card, recurring investing starts",
  },
  {
    stage: "Primary bank",
    status: "Income and daily spend both run through MariBank",
    milestone: "Salary credit, GIRO auto-debit, rising average daily balance",
  },
];

const measurementRows = [
  {
    layer: "Ecosystem",
    metrics: "Products per household, cross-product retention",
    design: "Cross-sell paths, home-page distribution",
  },
  {
    layer: "ShopeePay",
    metrics: "Payment penetration, cross-sell conversion",
    design: "Payment flow, funding-source switching, landing pages",
  },
  {
    layer: "SPayLater",
    metrics: "Credit-to-first-use conversion, on-time repayment rate",
    design: "Checkout presentation, fee disclosure, repayment reminders & flow",
  },
  {
    layer: "Digital Bank",
    metrics: "Deposit balance, % of users with salary credit",
    design: "Onboarding flow, home information architecture, primary-bank features",
  },
  {
    layer: "Brand",
    metrics: "Brand awareness, % acquisition outside Shopee",
    design: "Brand system & marketing assets",
  },
];
---

<BaseLayout
  title="Monee Ecosystem & Product Design Strategy — Lin Hongyu"
  description="How Monee's design team is building an independent financial ecosystem out of Shopee, with a clear role, principles, and design levers for every product."
>
  <!-- Hero -->
  <section class="section case-hero">
    <div class="wrap">
      <a class="back" href="/project">&larr; Back to Work</a>
      <p class="eyebrow eyebrow--accent">Strategy</p>
      <h1>Monee Ecosystem &amp; Product Design Strategy</h1>
      <p class="case-subtitle">
        Monee is moving from a financial matrix inside Shopee toward
        an independent financial ecosystem — a shift that defines
        three priorities for our design strategy.
      </p>
      <p class="case-byline">Head of Design&ensp;|&ensp;2021–Present</p>

      <div class="eco-hero-diagram" role="img" aria-label="Monee sits at the center of five products — ShopeePay, SPayLater & Credit, Digital Bank, Investment, and Insurance — inside an outer arc labeled Shopee, showing the ecosystem growing out of Shopee and extending beyond it.">
        <svg viewBox="0 0 800 420" xmlns="http://www.w3.org/2000/svg">
          <path d="M 60 340 A 370 370 0 0 1 740 340" fill="none" stroke="var(--color-line)" stroke-width="2" stroke-dasharray="4 8" />
          <text x="400" y="50" text-anchor="middle" class="eco-hero-arc-label">Shopee</text>
          <g class="eco-hero-spokes">
            <line x1="400" y1="230" x2="400" y2="120" />
            <line x1="400" y1="230" x2="240" y2="300" />
            <line x1="400" y1="230" x2="320" y2="340" />
            <line x1="400" y1="230" x2="480" y2="340" />
            <line x1="400" y1="230" x2="560" y2="300" />
          </g>
          <circle cx="400" cy="230" r="58" class="eco-hero-center" />
          <text x="400" y="236" text-anchor="middle" class="eco-hero-center-label">Monee</text>
          <g>
            <circle cx="400" cy="120" r="40" class="eco-hero-node" />
            <text x="400" y="124" text-anchor="middle" class="eco-hero-node-label">ShopeePay</text>
          </g>
          <g>
            <circle cx="240" cy="300" r="40" class="eco-hero-node" />
            <text x="240" y="298" text-anchor="middle" class="eco-hero-node-label">SPayLater</text>
            <text x="240" y="312" text-anchor="middle" class="eco-hero-node-label">&amp; Credit</text>
          </g>
          <g>
            <circle cx="320" cy="340" r="40" class="eco-hero-node" />
            <text x="320" y="338" text-anchor="middle" class="eco-hero-node-label">Digital</text>
            <text x="320" y="352" text-anchor="middle" class="eco-hero-node-label">Bank</text>
          </g>
          <g>
            <circle cx="480" cy="340" r="40" class="eco-hero-node" />
            <text x="480" y="344" text-anchor="middle" class="eco-hero-node-label">Investment</text>
          </g>
          <g>
            <circle cx="560" cy="300" r="40" class="eco-hero-node" />
            <text x="560" y="304" text-anchor="middle" class="eco-hero-node-label">Insurance</text>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <section class="section case-body">
    <div class="wrap">
      <div class="case-chapters">
        <!-- Business background — plain paragraph in the doc, no
             highlight; a light structure diagram carries it visually
             without over-building what wasn't asked for. -->
        <div class="case-chapter">
          <h2>Business background</h2>
          <div class="context-grid">
            <div class="context-diagram" role="img" aria-label="Sea Limited branches into Garena (gaming), Shopee (e-commerce), and Monee (digital finance, highlighted).">
              <div class="context-root">Sea Limited</div>
              <div class="context-branches">
                <div class="context-branch">Garena<span>Gaming</span></div>
                <div class="context-branch">Shopee<span>E-commerce</span></div>
                <div class="context-branch context-branch--active">Monee<span>Digital finance</span></div>
              </div>
            </div>
            <p class="chapter-lead">
              Sea Limited is made up of three businesses: Garena
              (gaming), Shopee (e-commerce), and Monee (digital
              finance). Monee began as a prepaid card network for
              Garena's gamers, then grew through Shopee into a
              financial platform spanning payments, credit, banking,
              wealth management, and insurance.
            </p>
          </div>
        </div>

        <!-- Our view on fintech — plain text in the doc. -->
        <div class="case-chapter">
          <h2>Our view on fintech</h2>
          <p class="chapter-lead">
            Many fintech products still build with a traditional
            finance mindset, answering "what can we offer" rather
            than "what do specific users need."
          </p>
          <div class="callout">
            <p class="callout-body">
              We believe real fintech uses digital platforms with a
              clear goal and positioning — designing around specific
              users' specific needs, and delivering a simple,
              trustworthy experience.
            </p>
          </div>
        </div>

        <!-- Who we serve — HIGHLIGHTED: "turn the table into a
             vertical structure, give each user type an avatar, and
             show its typical markets as flags." Replaces a 2-column
             table with a vertical stack of cards, each with an
             avatar icon and flag emoji standing in for the markets
             column. -->
        <div class="case-chapter">
          <h2>Who we serve</h2>
          <p class="chapter-lead">
            Our users are people traditional financial services
            overlook — but "overlooked" means something different in
            each market, and so does the design strategy.
          </p>
          <div class="who-list">
            {
              whoWeServe.map((w) => (
                <div class="who-card">
                  <div class="who-avatar" aria-hidden="true">
                    <svg viewBox="0 0 48 48">
                      <circle cx="24" cy="18" r="9" />
                      <path d="M6 44c0-10 8-16 18-16s18 6 18 16" />
                    </svg>
                  </div>
                  <div class="who-content">
                    <p class="who-title">{w.title}</p>
                    <p class="who-flags" aria-label={w.markets}>
                      {w.flags}
                      <span class="who-markets">{w.markets}</span>
                    </p>
                    <p class="who-traits">{w.traits}</p>
                    <p class="who-focus">Design focus: {w.focus}</p>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="chapter-note">
            Shared traits: young and middle-aged internet users, most
            with above-average education; as Shopee users, they're
            price-sensitive and value-for-money minded. We compete
            off-axis from traditional banks, investment firms, and
            brokerages — the goal is to accompany users from "few
            assets, little financial knowledge" to "more assets,
            without needing to become a finance expert."
          </p>
        </div>

        <!-- Monee's growth path — HIGHLIGHTED twice: the phase
             timeline, and the three strategy priorities. -->
        <div class="case-chapter">
          <h2>Monee's growth path</h2>
          <div class="phase-timeline">
            {
              phases.map((p, i) => (
                <>
                  <div class="phase-step">
                    <p class="phase-tag">{p.tag}</p>
                    <p class="phase-title">{p.title}</p>
                    {p.body && <p class="phase-body">{p.body}</p>}
                  </div>
                  {i === 1 && <div class="phase-marker">We are here</div>}
                </>
              ))
            }
          </div>
          <p class="chapter-lead">
            Monee is moving from "a financial matrix inside Shopee"
            toward "an independent financial ecosystem." That shift
            defines three priorities for our design strategy:
          </p>
          <div class="card-row">
            {
              strategyPriorities.map((s) => (
                <div class="numbered-card">
                  <p class="numbered-card-n">{s.n}</p>
                  <p class="numbered-card-title">{s.title}</p>
                  <p class="numbered-card-body">{s.body}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Monee ecosystem overview — HIGHLIGHTED: "visualize the
             table content." Same interactive node pattern as before:
             hover/tap a product for what it includes, its role, and
             its metrics. -->
        <div class="case-chapter">
          <h2>Monee ecosystem overview</h2>
          <p class="chapter-lead">
            Hover (or tap) a product for what it includes, its
            ecosystem role, and its core metrics.
          </p>
          <div class="eco-map">
            {
              ecosystemNodes.map((node) => (
                <button type="button" class="eco-node">
                  <span class="eco-node-name">{node.name}</span>
                  <span class="eco-node-detail">
                    <span class="eco-node-detail-inner">
                      <span class="eco-node-includes">{node.includes}</span>
                      <span class="eco-node-role">{node.role}</span>
                      <span class="eco-node-metrics">{node.metrics}</span>
                    </span>
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <!-- Market segmentation — plain table in the doc. -->
        <div class="case-chapter">
          <h2>Market segmentation</h2>
          <p class="chapter-lead">The path out of Shopee differs by market.</p>
          <div class="market-table">
            {
              marketRows.map((row) => (
                <div class="market-row">
                  <p class="market-group">{row.group}</p>
                  <p class="market-markets">{row.markets}</p>
                  <p class="market-vehicle">{row.vehicle}</p>
                  <p class="market-focus">{row.focus}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Experience design principles — HIGHLIGHTED: "three
             circles for the three keywords, description below each
             circle." -->
        <div class="case-chapter">
          <h2>Fintech experience principles: Reliable, Simple, Rewarding</h2>
          <div class="principle-circles">
            {
              principles.map((p) => (
                <div class="principle-col">
                  <div class="principle-circle">{p.title}</div>
                  <p class="principle-body">{p.body}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Product strategy -->
        <div class="case-chapter">
          <h2>Product strategy</h2>
          <p class="chapter-lead">
            Every product follows the same structure: ecosystem role,
            core metrics, design levers, key trade-offs.
          </p>

          <h3>ShopeePay: traffic gateway</h3>
          <p class="chapter-lead">
            Role: captures Shopee's traffic and distributes it to
            other financial products for cross-sell.
          </p>
          <div class="lever">
            <p class="lever-title">Lever 1 — Awareness: establish the payment entry point</p>
            <p class="lever-body">
              Embed ShopeePay into payment moments inside and outside
              Shopee, so users notice it every time they pay.
            </p>
            <div class="phone-shots">
              <PlaceholderImage ratio="9/19" radius="20px" label="Payment moment 1" />
              <PlaceholderImage ratio="9/19" radius="20px" label="Payment moment 2" />
              <PlaceholderImage ratio="9/19" radius="20px" label="Payment moment 3" />
            </div>
          </div>
          <div class="lever">
            <p class="lever-title">Lever 2 — Retention: a smooth experience and rewards</p>
            <ul class="lever-list">
              <li>Unify funding sources: switch seamlessly between ShopeePay balance, SPayLater, and linked bank accounts at checkout.</li>
              <li>Simplify the flow: keep only what matters at the moment of payment.</li>
              <li>Reward: borrow e-commerce growth tactics to lift engagement, within the bounds of responsible rewarding.</li>
            </ul>
            <div class="phone-shots">
              <PlaceholderImage ratio="9/19" radius="20px" label="Funding source switch" />
              <PlaceholderImage ratio="9/19" radius="20px" label="Simplified checkout" />
              <PlaceholderImage ratio="9/19" radius="20px" label="Reward moment" />
            </div>
          </div>
          <div class="lever">
            <p class="lever-title">Lever 3 — Conversion: efficient distribution</p>
            <p class="lever-body">
              Home screen: information architecture designed for
              distribution efficiency, separating soft conversion
              (content, perks) from hard conversion (direct
              application entry points).
            </p>
            <div class="phone-shots">
              <PlaceholderImage ratio="9/19" radius="20px" label="ShopeePay home" />
            </div>
            <p class="lever-body">
              Landing pages: designed around reach, understanding, and
              conversion.
            </p>
            <div class="phone-shots">
              <PlaceholderImage ratio="9/19" radius="20px" label="Landing page — reach" />
              <PlaceholderImage ratio="9/19" radius="20px" label="Landing page — understanding" />
              <PlaceholderImage ratio="9/19" radius="20px" label="Landing page — conversion" />
            </div>
          </div>
          <div class="callout">
            <p class="callout-title">Key trade-off</p>
            <p class="callout-body">
              Don't interrupt the transaction — only distribute while
              browsing. The payment flow serves payment alone;
              cross-sell happens after payment completes and on the
              home screen. This rule also arbitrates competing claims
              on home-screen real estate across business lines.
            </p>
          </div>

          <h3>SPayLater: revenue engine</h3>
          <p class="chapter-lead">
            Role: Monee's primary source of revenue and profit, and
            most users' first touchpoint with Monee credit.
          </p>
          <div class="lever">
            <p class="lever-title">Activation</p>
            <p class="lever-body">
              Surface it at every relevant touchpoint inside the
              Shopee journey, shortening the path from getting a
              credit line to first use.
            </p>
            <div class="phone-shots">
              <PlaceholderImage ratio="9/19" radius="20px" label="Credit line touchpoint 1" />
              <PlaceholderImage ratio="9/19" radius="20px" label="Credit line touchpoint 2" />
              <PlaceholderImage ratio="9/19" radius="20px" label="Credit line touchpoint 3" />
            </div>
          </div>
          <div class="lever">
            <p class="lever-title">Retention — cross-sell and promotion</p>
            <p class="lever-body">
              SPayLater home redesign: efficient cross-sell of goods
              and add-on products.
            </p>
            <div class="phone-shots">
              <PlaceholderImage ratio="9/19" radius="20px" label="SPayLater home" />
            </div>
          </div>

          <h3>MariBank: long-term growth engine</h3>
          <p class="chapter-lead">
            Role: captures traffic from ShopeePay and external
            channels, converting it into high-value, loyal users.
          </p>
          <p class="chapter-lead">
            Challenge: Singapore has high banking penetration — users
            hold 3+ banking relationships on average. Incumbents lock
            users in with Total Relationship Banking and Priority
            Banking, and since banking products look alike, switching
            a primary account is costly.
          </p>
          <div class="card-row card-row--three">
            <div class="value-card">
              <p class="value-card-title">Unconditional savings account</p>
              <p class="value-card-body">No salary credit required, no minimum balance.</p>
            </div>
            <div class="value-card">
              <p class="value-card-title">No-frills credit card</p>
              <p class="value-card-body">Easy-to-calculate cashback, no cap, no minimum spend.</p>
            </div>
            <div class="value-card">
              <p class="value-card-title">Investing products</p>
              <p class="value-card-body">The lowest fees in the industry.</p>
            </div>
          </div>
          <p class="chapter-lead">
            Our wedge: experience is our main competitive edge —
            simplicity and clarity.
          </p>

          <!-- MariBank lifecycle — HIGHLIGHTED: "visualize the
               table; horizontal axis of three stages, each with user
               status + experience milestones, each stage reserves
               three phone screens." -->
          <h4>1. From secondary to primary bank</h4>
          <p class="chapter-lead">
            MariBank's current position is a user's secondary bank;
            the long-term goal is to become the primary bank for
            young users. We break that into three stages, each with
            its own experience milestones.
          </p>
          <div class="steps-diagram">
            {
              mariBankStages.map((s) => (
                <div class="steps-step">
                  <p class="steps-stage">{s.stage}</p>
                  <p class="steps-status">{s.status}</p>
                  <p class="steps-milestone">{s.milestone}</p>
                  <div class="phone-shots phone-shots--compact">
                    <PlaceholderImage ratio="9/19" radius="16px" label="Screen 1" />
                    <PlaceholderImage ratio="9/19" radius="16px" label="Screen 2" />
                    <PlaceholderImage ratio="9/19" radius="16px" label="Screen 3" />
                  </div>
                </div>
              ))
            }
          </div>

          <h4>2. Acquisition &amp; cross-sell paths</h4>
          <p class="chapter-lead">
            More precise cross-sell touch points, across two
            dimensions: goal and need.
          </p>
          <p class="lever-title">By goal</p>
          <div class="lever">
            <p class="lever-body">
              Clear-goal users: a direct entry point straight to the
              product.
            </p>
            <div class="phone-shots">
              <PlaceholderImage ratio="9/19" radius="20px" label="Direct entry point" />
            </div>
          </div>
          <div class="lever">
            <p class="lever-body">
              Unclear-goal users: loosely matched via Shopee perks and
              the mission center.
            </p>
            <div class="phone-shots">
              <PlaceholderImage ratio="9/19" radius="20px" label="Mission center 1" />
              <PlaceholderImage ratio="9/19" radius="20px" label="Mission center 2" />
              <PlaceholderImage ratio="9/19" radius="20px" label="Mission center 3" />
            </div>
          </div>
          <p class="lever-title">By need</p>
          <div class="lever">
            <p class="lever-body">
              Investing-minded users: Shopee high-interest perk or
              external channel &rarr; savings &rarr; investing &amp;
              stock trading.
            </p>
            <p class="lever-body">
              Our users are mostly non-professional investors without
              a full investing framework yet. We skip fund
              supermarkets and performance rankings, since chasing
              rankings encourages performance-chasing behavior unsuited
              to non-professionals. We return to investing
              fundamentals: present funds by asset class, and plot
              them on a long-term risk/return map so users can see the
              full picture and build realistic expectations. The
              information architecture stays simple and in the user's
              control without encouraging over-decision-making; the
              wealth side emphasizes the product matrix and trust, the
              trading side keeps the product line lean.
            </p>
            <div class="phone-shots">
              <PlaceholderImage ratio="9/19" radius="20px" label="Investing screen 1" />
              <PlaceholderImage ratio="9/19" radius="20px" label="Investing screen 2" />
              <PlaceholderImage ratio="9/19" radius="20px" label="Investing screen 3" />
            </div>
          </div>
          <div class="lever">
            <p class="lever-body">
              Spending-minded users: Shopee voucher or external
              channel &rarr; savings &rarr; payments &amp; credit
              card.
            </p>
            <p class="lever-body">
              Rewards that are simple to calculate (credit card
              cashback, transparent exchange rates); flows as short as
              compliance allows; one job per screen.
            </p>
            <div class="phone-shots">
