---
// Strategy case study — content from "Lin_Hongyu_Design_Memo_v2"
// (Google Doc), laid out per a visual reference mockup the user
// shared afterward. The mockup's own color/type system (bright
// orange, Outfit/Noto Sans SC, a script cursive font) isn't used
// here — this reuses the site's existing tokens (system-ui font,
// muted terracotta accent) so the page matches the rest of the site,
// per the standing "keep the design consistent" brief. What's
// adopted from the mockup is its layout: the chevron phase/stage
// badges, the hub-and-spoke ecosystem diagram, the overlapping
// principle circles, the persona cards with real flag icons, the
// product-strategy chapter divider, and the bracketed metrics tree.
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderImage from "../../components/PlaceholderImage.astro";
import PhoneFrame from "../../components/PhoneFrame.astro";
import strategyImage from "../../assets/work/strategy.png";

const personas = [
  {
    avatar: "a",
    title: "The financially underserved",
    subtitle: "Underserved by access",
    flags: ["id", "ph", "vn", "br"],
    marketsLabel: "Typical markets",
    traits:
      "Few assets, limited financial literacy — many get their first line of credit and their first account through Shopee.",
    focus:
      "Lower the barrier to understanding, build first-time trust, help users form healthy credit habits.",
  },
  {
    avatar: "b",
    title: "Overlooked by experience and value",
    subtitle: "Underserved by experience",
    flags: ["sg", "my", "th"],
    marketsLabel: "Typical markets · urban users",
    traits:
      "Already banked, but excluded by high thresholds, bundling, and cold experiences.",
    focus:
      "Win users from traditional banks with unconditional, transparent value and a better experience.",
  },
];

const flagNames: Record<string, string> = {
  id: "Indonesia",
  ph: "Philippines",
  vn: "Vietnam",
  br: "Brazil",
  sg: "Singapore",
  my: "Malaysia",
  th: "Thailand",
};

const phases = [
  { tag: "Phase 1", title: "Payments for games & e-commerce", body: "Payments for games and e-commerce." },
  {
    tag: "Phase 2",
    title: "A financial matrix inside Shopee",
    body: "Used Shopee's traffic to serve buyers and sellers: payment, loan, banking and digital services.",
  },
  {
    tag: "Phase 3",
    title: "An independent financial ecosystem",
    body: "Grow beyond Shopee through ShopeePay and digital banks, and serve more underserved users.",
    here: true,
  },
];

const strategyPriorities = [
  { n: "01", title: "Segment by market", body: "Plan the exit from Shopee by market type, not a single path." },
  {
    n: "02",
    title: "Trust first",
    body: "Put trust first among experience principles, with a clear trade-off rule between growth and responsible finance.",
  },
  {
    n: "03",
    title: "Clear, measurable roles",
    body: "Define a clear role, core metrics, and design levers for every product in the ecosystem, so design's contribution can be measured.",
  },
];

const ecoNodes = [
  {
    role: "Revenue engine",
    name: "SPayLater & Credit",
    dot: "orange",
    chips: ["BNPL", "Cash loans", "Seller financing"],
    body: "Monee's main source of revenue and profit",
    metrics: "Credit-to-first-use conversion, GMV penetration, on-time repayment rate",
  },
  {
    role: "Long-term growth engine",
    name: "MariBank",
    dot: "orange",
    chips: ["Savings", "Fixed deposits", "Credit cards", "Cash loans"],
    body: "Converts traffic into high-value, loyal users with low-cost funding",
    metrics: "Deposit balance, products per household, primary-bank metrics",
  },
  {
    role: "Asset retention",
    name: "Investment",
    dot: "green",
    chips: ["Mari Invest funds", "Stock trading", "Gold"],
    body: "Attracts wealthier users, deepens asset retention",
    metrics: "AUM, investor conversion rate",
  },
  {
    role: "Transaction coverage",
    name: "Insurance",
    dot: "blue",
    chips: ["Product protection", "Digital product insurance"],
    body: "Supplementary coverage in transaction moments, lifts order value",
    metrics: "Attach rate, claims satisfaction",
  },
];

const markets = [
  {
    tone: "bank",
    title: "Bank licensed markets",
    flags: ["sg", "id", "ph"],
    vehicle: "Digital bank",
    focus: "Capture deposits, move from secondary to primary bank, cross-sell",
  },
  {
    tone: "wallet",
    title: "E-wallet + credit",
    flags: ["my", "th", "vn", "br"],
    vehicle: "ShopeePay app, off-platform SPayLater",
    focus: "Expand into offline & off-platform payments, build an off-platform credit experience",
  },
];

const principles = [
  {
    title: "Reliable",
    body: "Security and trust matter most in a financial product — the safety of funds, transparent information, anti-fraud protection, and staying dependable when something goes wrong.",
  },
  {
    title: "Simple",
    body: "Financial products often feel expert, complex, and distant. The brand should be approachable and the experience easy to understand — users can describe what each product does in one sentence.",
  },
  {
    title: "Rewarding",
    body: "Deliver real value: solve real needs around saving, borrowing, transferring, investing, and insuring — or offer competitive products and rewards.",
  },
];

const mariBankStages = [
  {
    stage: "Stage 1",
    title: "Secondary bank",
    status: "Parks spare cash in MariBank, enjoys Shopee-linked perks",
    milestones: ["Account opening", "First deposit", "First cross-sell"],
    screens: ["Account opening", "First deposit", "Cross-sell"],
  },
  {
    stage: "Stage 2",
    title: "Scenario of choice",
    status: "Picks MariBank first for specific spending or investing scenarios",
    milestones: ["Card becomes daily driver", "Recurring investing starts"],
    screens: ["Credit card", "Cashback", "Recurring invest"],
  },
  {
    stage: "Stage 3",
    title: "Primary bank",
    status: "Income and daily spend both run through MariBank",
    milestones: ["Salary credit", "GIRO auto-debit", "Rising average balance"],
    screens: ["Salary credit", "GIRO", "Balance overview"],
  },
];

const measurementRows = [
  { layer: "Ecosystem", metrics: "Products per household, cross-product retention", design: "Cross-sell paths, home-page distribution" },
  { layer: "ShopeePay", metrics: "Payment penetration, cross-sell conversion", design: "Payment flow, funding-source switching, landing pages" },
  { layer: "SPayLater", metrics: "Credit-to-first-use conversion, on-time repayment rate", design: "Checkout presentation, fee disclosure, repayment reminders & flow" },
  { layer: "Digital Bank", metrics: "Deposit balance, % of users with salary credit", design: "Onboarding flow, home information architecture, primary-bank features" },
  { layer: "Brand", metrics: "Brand awareness, % acquisition outside Shopee", design: "Brand system & marketing assets" },
];
---

<BaseLayout
  title="Monee Ecosystem & Product Design Strategy — Lin Hongyu"
  description="How Monee's design team is building an independent financial ecosystem out of Shopee, with a clear role, principles, and design levers for every product."
>
  <div class="case-page">
  <!-- Flag icon sprite, reused by the persona and market cards. Flat
       geometric renditions (not photographic), ported as-is. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="f-id" viewBox="0 0 30 20"><rect width="30" height="10" fill="#CE1126"/><rect y="10" width="30" height="10" fill="#FFFFFF"/></symbol>
    <symbol id="f-sg" viewBox="0 0 30 20"><rect width="30" height="10" fill="#EF3340"/><rect y="10" width="30" height="10" fill="#FFFFFF"/><circle cx="7" cy="5" r="3.2" fill="#FFFFFF"/><circle cx="8.3" cy="5" r="3" fill="#EF3340"/><circle cx="11" cy="3.2" r=".7" fill="#FFFFFF"/><circle cx="13" cy="4.6" r=".7" fill="#FFFFFF"/><circle cx="12.2" cy="6.8" r=".7" fill="#FFFFFF"/><circle cx="9.8" cy="6.8" r=".7" fill="#FFFFFF"/><circle cx="9" cy="4.6" r=".7" fill="#FFFFFF"/></symbol>
    <symbol id="f-ph" viewBox="0 0 30 20"><rect width="30" height="10" fill="#0038A8"/><rect y="10" width="30" height="10" fill="#CE1126"/><polygon points="0,0 17,10 0,20" fill="#FFFFFF"/><circle cx="6" cy="10" r="2.4" fill="#FCD116"/></symbol>
    <symbol id="f-vn" viewBox="0 0 30 20"><rect width="30" height="20" fill="#DA251D"/><polygon points="15,4 16.4,8.1 20.7,8.1 17.2,10.7 18.5,14.9 15,12.3 11.5,14.9 12.8,10.7 9.3,8.1 13.6,8.1" fill="#FFFF00"/></symbol>
    <symbol id="f-br" viewBox="0 0 30 20"><rect width="30" height="20" fill="#009B3A"/><polygon points="15,2.5 27.5,10 15,17.5 2.5,10" fill="#FEDF00"/><circle cx="15" cy="10" r="4.4" fill="#002776"/></symbol>
    <symbol id="f-my" viewBox="0 0 30 20"><rect width="30" height="20" fill="#FFFFFF"/><rect y="0" width="30" height="1.43" fill="#CC0001"/><rect y="2.86" width="30" height="1.43" fill="#CC0001"/><rect y="5.71" width="30" height="1.43" fill="#CC0001"/><rect y="8.57" width="30" height="1.43" fill="#CC0001"/><rect y="11.43" width="30" height="1.43" fill="#CC0001"/><rect y="14.29" width="30" height="1.43" fill="#CC0001"/><rect y="17.14" width="30" height="1.43" fill="#CC0001"/><rect width="15" height="11.43" fill="#010066"/><circle cx="6" cy="5.7" r="3.6" fill="#FFCC00"/><circle cx="7.2" cy="5.7" r="3.1" fill="#010066"/><polygon points="11.5,3.2 12.2,5 14,5 12.6,6.1 13.1,7.9 11.5,6.8 9.9,7.9 10.4,6.1 9,5 10.8,5" fill="#FFCC00"/></symbol>
    <symbol id="f-th" viewBox="0 0 30 20"><rect width="30" height="20" fill="#A51931"/><rect y="3.33" width="30" height="13.34" fill="#F4F5F8"/><rect y="6.67" width="30" height="6.66" fill="#2D2A4A"/></symbol>
  </svg>

  <!-- Hero -->
  <section class="section case-hero">
    <div class="wrap case-hero-center">
      <h1>Monee Ecosystem &amp; Product Design Strategy</h1>
      <p class="case-subtitle">
        Based on high-level business strategy, defining Monee's
        ecosystem and product design strategy from a systemic
        perspective, so it moves in lockstep with business growth.
      </p>
    </div>
    <div class="wrap">
      <div class="case-hero-banner-frame">
        <Image
          src={strategyImage}
          alt="Monee ecosystem strategy"
          widths={[800, 1200, 1600, 2000]}
          sizes="100vw"
          class="case-hero-banner-img"
        />
      </div>
    </div>
  </section>

  <!-- 01 Business background -->
  <section class="section case-chapter case-chapter--center" id="background">
    <div class="wrap">
      <header class="sh">
        <p class="eyebrow"><span class="no">01</span>Business background</p>
        <h2>
          Monee, Sea's third business: from a gaming prepaid-card
          network, then grew through Shopee into a financial platform
          spanning payment, credits, banking, wealth management and
          insurance.
        </h2>
      </header>
      <div class="org" role="img" aria-label="Sea Limited branches into Garena (gaming), Shopee (e-commerce), and Monee (digital finance, highlighted), covering payments, credit, banking, wealth, and insurance.">
        <div class="org-root">
          <img src="/logos/sea.svg" alt="" class="org-root-logo" />
          Sea Limited
        </div>
        <div class="org-kids">
          <div class="bubble">
            <img src="/logos/garena.png" alt="Garena" class="org-logo" />
            <small>Gaming</small>
          </div>
          <div class="bubble">
            <img src="/logos/shopee.svg" alt="Shopee" class="org-logo" />
            <small>E-commerce</small>
          </div>
          <div class="bubble bubble--hot">
            Monee
            <small>Digital finance</small>
          </div>
        </div>
        <div class="org-chips">
          <span class="pill pill--accent">Payments</span>
          <span class="pill pill--accent">Credit</span>
          <span class="pill pill--accent">Banking</span>
          <span class="pill pill--accent">Wealth</span>
          <span class="pill pill--accent">Insurance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Our view on fintech -->
  <section class="section case-chapter case-chapter--alt case-chapter--center" id="belief">
    <div class="wrap">
      <header class="sh">
        <p class="eyebrow"><span class="no">02</span>Our view on fintech</p>
      </header>
      <div class="belief-grid">
        <div>
          <div class="quote-mark" aria-hidden="true">&ldquo;</div>
          <h3 class="belief-quote">
            Real fintech uses digital platforms with a clear goal and
            positioning — designing around specific users' specific
            needs, and delivering a simple, trustworthy experience.
          </h3>
        </div>
        <div class="vs-grid">
          <div class="vs-side vs-side--old">
            <span class="vs-label">Traditional finance mindset</span>
            <p class="vs-q">"What can we offer?"</p>
            <div class="flowline"><span class="pill">Product</span><span class="vs-arrow">&rarr;</span><span class="pill">User</span></div>
            <p class="vs-note">Many fintech products still build with a traditional finance mindset.</p>
          </div>
          <div class="vs-mid" aria-hidden="true">vs</div>
          <div class="vs-side vs-side--new">
            <span class="vs-label">Our mindset</span>
            <p class="vs-q">"What do specific users need?"</p>
            <div class="flowline"><span class="pill pill--light">User need</span><span class="vs-arrow vs-arrow--light">&rarr;</span><span class="pill pill--light">Product</span></div>
            <p class="vs-note vs-note--light">We design products starting from specific users' specific needs.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Who we serve -->
  <section class="section case-chapter case-chapter--center" id="users">
    <div class="wrap">
      <header class="sh">
        <p class="eyebrow"><span class="no">03</span>Who we serve</p>
        <h2>Our users are people traditional financial services overlook</h2>
        <p class="sh-sub">But "overlooked" means something different in each market.</p>
      </header>
      <div class="personas">
        {personas.map((p) => (
          <article class="persona">
            <div class="persona-head">
              {p.avatar === "a" ? (
                <svg class="avatar" viewBox="0 0 76 76" aria-hidden="true"><circle cx="38" cy="38" r="38" fill="var(--color-accent-soft)"/><path d="M16 76c2-14 11-22 22-22s20 8 22 22z" fill="var(--color-accent)"/><circle cx="38" cy="34" r="15" fill="#E7B48C"/><path d="M22 30c0-11 8-17 16-17s16 6 16 17c-3-5-9-8-16-8s-13 3-16 8z" fill="#2B1B12"/><path d="M20 26h36v-4c0-2-2-4-4-4H24c-2 0-4 2-4 4z" fill="#1747EE"/><path d="M48 22h14v4H48z" fill="#1747EE"/><circle cx="32.5" cy="35" r="1.6" fill="#2B1B12"/><circle cx="43.5" cy="35" r="1.6" fill="#2B1B12"/><path d="M33 41c3 3 7 3 10 0" stroke="#2B1B12" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
              ) : (
                <svg class="avatar" viewBox="0 0 76 76" aria-hidden="true"><circle cx="38" cy="38" r="38" fill="rgba(23,20,15,0.06)"/><path d="M16 76c2-14 11-22 22-22s20 8 22 22z" fill="var(--color-ink)"/><path d="M33 54h10l-5 9z" fill="#FFFFFF"/><circle cx="38" cy="34" r="15" fill="#F2CBA8"/><path d="M23 33c-2-13 7-20 15-20 9 0 17 6 15 20-2-6-6-10-15-10-8 0-12 4-15 10z" fill="#3A2A20"/><circle cx="32" cy="35" r="4.5" fill="none" stroke="var(--color-ink)" stroke-width="1.6"/><circle cx="44" cy="35" r="4.5" fill="none" stroke="var(--color-ink)" stroke-width="1.6"/><path d="M36.5 35h3" stroke="var(--color-ink)" stroke-width="1.6"/><circle cx="32" cy="35" r="1.3" fill="var(--color-ink)"/><circle cx="44" cy="35" r="1.3" fill="var(--color-ink)"/><path d="M34 42c2.5 2 5.5 2 8 0" stroke="var(--color-ink)" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
              )}
              <div>
                <h3>{p.title}</h3>
                <p class="persona-subtitle">{p.subtitle}</p>
              </div>
            </div>
            <div class="persona-row">
              <span class="label">{p.marketsLabel}</span>
              <div class="flags">
                {p.flags.map((f) => (
                  <span class="flag"><svg><use href={`#f-${f}`}/></svg>{flagNames[f]}</span>
                ))}
              </div>
            </div>
            <div class="persona-row">
              <span class="label">Traits</span>
              <p>{p.traits}</p>
            </div>
            <div class="persona-row persona-row--focus">
              <span class="label">Design focus</span>
              <p><b>{p.focus}</b></p>
            </div>
          </article>
        ))}
      </div>
      <div class="common-band">
        <div>
          <span class="label">What both groups share</span>
          <p class="common-body">
            Young and middle-aged internet users, mostly with
            above-average education; as Shopee users, they're
            price-sensitive and value-for-money minded. We compete
            off-axis from traditional banks, investment firms, and
            brokerages.
          </p>
        </div>
        <div class="journey">
          <span class="pill pill--on-dark">Few assets · little financial knowledge</span>
          <span class="vs-arrow vs-arrow--accent">&rarr;</span>
          <span class="pill pill--goal">More assets · still no need to become a finance expert</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Growth path -->
  <section class="section case-chapter case-chapter--alt case-chapter--center" id="path">
    <div class="wrap">
      <header class="sh">
        <p class="eyebrow"><span class="no">04</span>Growth path</p>
        <h2>Monee is moving from "a financial matrix inside Shopee" toward "an independent financial ecosystem"</h2>
      </header>
      <div class="phases">
        {phases.map((p) => (
          <div class={`phase ${p.here ? "phase--active" : ""}`}>
            <div class="phase-tag-row">
              <span class="phase-tag">{p.tag}</span>
              {p.here && <span class="here-badge">We are here</span>}
            </div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
      <div class="arrow-block">
        <p class="sub-p arrow-caption">That shift defines three priorities for our design strategy:</p>
        <div class="arrow-down" aria-hidden="true">
        <svg viewBox="0 0 36 66" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="arrowFade" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--color-ink-faint)" stop-opacity="0.1" />
              <stop offset="100%" stop-color="var(--color-ink-faint)" stop-opacity="0.9" />
            </linearGradient>
          </defs>
          <line x1="18" y1="3" x2="18" y2="48" stroke="url(#arrowFade)" stroke-width="2.5" />
          <path d="M4.5 38 L18 54 L31.5 38" stroke="var(--color-ink-faint)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        </div>
      </div>
      <div class="focus3">
        {strategyPriorities.map((s) => (
          <div class="focus-card">
            <span class="ghost-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 Ecosystem overview -->
  <section class="section case-chapter case-chapter--center" id="eco">
    <div class="wrap">
      <header class="sh">
        <p class="eyebrow"><span class="no">05</span>Ecosystem overview</p>
        <h2>ShopeePay captures the traffic; four products each capture a different kind of value</h2>
      </header>
      <div class="eco">
        <div class="eco-source">
          <div class="eco-source-item">
            <span class="pill">Inside-Shopee traffic</span>
            <span class="eco-source-line" aria-hidden="true"></span>
            <span class="eco-source-arrow" aria-hidden="true"></span>
          </div>
          <div class="eco-source-item">
            <span class="pill">Outside-Shopee scenarios</span>
            <span class="eco-source-line" aria-hidden="true"></span>
            <span class="eco-source-arrow" aria-hidden="true"></span>
          </div>
        </div>
        <div class="eco-hub">
          <div class="eco-hub-copy">
            <span class="eco-role eco-role--hub"><i class="eco-dot--orange"></i>Traffic gateway</span>
            <div class="eco-hub-name">ShopeePay</div>
            <div class="chips chips--sm">
              <span class="pill">E-wallet</span><span class="pill">In/out-of-app payment</span><span class="pill">QR scan</span><span class="pill">Bill payment</span>
            </div>
            <p class="eco-hub-desc">Captures Shopee's traffic and distributes it to other financial products</p>
            <p class="eco-hub-metrics"><span class="muted">Core metrics:</span> payment penetration, MAU, cross-sell conversion</p>
          </div>
          <div class="eco-hub-phone">
            <PhoneFrame><PlaceholderImage ratio="9/19" label="ShopeePay home" /></PhoneFrame>
          </div>
        </div>
        <div class="eco-branch">
          {ecoNodes.map((n) => (
            <div class="eco-node">
              <div class="eco-node-copy">
                <span class="eco-role"><i class={`eco-dot--${n.dot}`}></i>{n.role}</span>
                <div class="eco-node-name">{n.name}</div>
                <div class="chips chips--sm">{n.chips.map((c) => <span class="pill">{c}</span>)}</div>
                <p class="eco-node-desc">{n.body}</p>
                <div class="eco-node-metrics"><b>Core metrics</b>{n.metrics}</div>
              </div>
              <div class="eco-node-phone">
                <PhoneFrame><PlaceholderImage ratio="9/19" label={`${n.name} home`} /></PhoneFrame>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 06 Market segmentation -->
  <section class="section case-chapter case-chapter--alt case-chapter--center" id="markets">
    <div class="wrap">
      <header class="sh">
        <p class="eyebrow"><span class="no">06</span>Market segmentation</p>
        <h2>The path out of Shopee differs by market</h2>
      </header>
      <div class="markets">
        {markets.map((m) => (
          <article class={`market market--${m.tone}`}>
            <div class="market-top">
              <h3>{m.title}</h3>
              <div class="flags">
                {m.flags.map((f) => <span class="flag" aria-label={flagNames[f]}><svg aria-hidden="true"><use href={`#f-${f}`}/></svg></span>)}
              </div>
            </div>
            <dl>
              <div><dt>Vehicle out of Shopee</dt><dd>{m.vehicle}</dd></div>
              <div><dt>Design focus</dt><dd>{m.focus}</dd></div>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 07 Experience principles -->
  <section class="section case-chapter case-chapter--center" id="principles">
    <div class="wrap">
      <header class="sh">
        <p class="eyebrow"><span class="no">07</span>Experience principles</p>
        <h2>Reliable, Simple, Rewarding</h2>
      </header>
      <div class="circles" aria-hidden="true">
        <div class="circle circle--1">Reliable</div>
        <div class="circle circle--2">Simple</div>
        <div class="circle circle--3">Rewarding</div>
      </div>
      <div class="pdesc">
        {principles.map((p) => (
          <div><h3>{p.title}</h3><p>{p.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 08 Product strategy divider -->
  <section class="divider" id="products" aria-labelledby="prod-title">
    <div class="divider-l">
