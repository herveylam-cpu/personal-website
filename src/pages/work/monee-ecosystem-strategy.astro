---
// Strategy case study — built from the spec doc section 4 (S-01
// through S-16). English copy throughout, translated from the
// (Chinese) spec to match the rest of the site's language; structure
// and all numbers/claims follow the spec verbatim, including its own
// [TBD] / [to verify] placeholders for content not yet supplied.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderImage from "../../components/PlaceholderImage.astro";

const overviewCards = [
  {
    n: "01",
    title: "Segment by market",
    body: "Markets are pulling away from Shopee's orbit at different speeds, so the experience roadmap differs by market.",
  },
  {
    n: "02",
    title: "Trust first",
    body: "Experience principles have an order — growth defers to responsible finance.",
  },
  {
    n: "03",
    title: "Clear, measurable roles",
    body: "Every product has a defined ecosystem role, metrics, and design levers.",
  },
];

const statCards = [
  { value: "$11.1B", label: "Loan book, up ~62% YoY" },
  { value: "40M+", label: "Active credit users" },
  { value: "$1.4B", label: "Monee quarterly revenue, up ~59% YoY" },
  { value: "1.0%", label: "90+ day NPL ratio" },
  { value: "$38.3B", label: "Shopee quarterly GMV" },
];

const principles = [
  {
    n: 1,
    title: "Reliable",
    body: "Security and trust matter most in a financial product.",
  },
  {
    n: 2,
    title: "Simple",
    body: "Users can describe what each product does in one sentence.",
  },
  {
    n: 3,
    title: "Rewarding",
    body: "Solve a real financial need with competitive value.",
  },
];

const ecosystemNodes = [
  {
    name: "ShopeePay",
    role: "Traffic gateway",
    metrics: "Payment penetration, cross-sell conversion",
  },
  {
    name: "SPayLater & Credit",
    role: "Revenue engine",
    metrics: "Credit-to-first-use conversion, on-time repayment rate",
  },
  {
    name: "MariBank / SeaBank",
    role: "Long-term growth engine",
    metrics: "Deposit balance, products per household",
  },
  {
    name: "Mari Invest",
    role: "Attracting wealthier users",
    metrics: "AUM, investor conversion rate",
  },
  {
    name: "Insurance",
    role: "Supplementary coverage in transaction moments",
    metrics: "Attach rate",
  },
];

const phases = [
  { tag: "Phase 1", title: "Powering payments for e-commerce & gaming" },
  { tag: "Phase 2", title: "A financial matrix inside the Shopee ecosystem" },
  { tag: "Phase 3", title: "An independent financial ecosystem, beyond Shopee" },
];

const marketRows = [
  {
    group: "Licensed markets",
    markets: "Singapore, Indonesia, Philippines",
    vehicle: "Digital bank",
    focus: "Capture deposits, move toward primary bank",
  },
  {
    group: "Wallet + credit",
    markets: "Malaysia, Thailand, Vietnam",
    vehicle: "ShopeePay app, off-platform SPayLater",
    focus: "Expand into offline & off-platform",
  },
  {
    group: "Growth market",
    markets: "Brazil",
    vehicle: "On-platform credit, standalone app rolling out",
    focus: "First-time credit experience, balancing growth and risk",
  },
];

const shopeePayFunnel = [
  {
    stage: "Awareness",
    body: "Embedded in payment moments, inside and outside Shopee.",
  },
  {
    stage: "Retention",
    body: "Unify funding sources, simplify the flow, reward usage.",
  },
  {
    stage: "Conversion",
    body: "Efficient home-screen distribution; landing pages designed for reach, understanding, and conversion.",
  },
];

const sPayLaterLifecycle = [
  { stage: "Get a credit line", lever: "Shorten the activation path" },
  { stage: "First use", lever: "Show installments & fees clearly at checkout" },
  { stage: "Ongoing use", lever: "Keep the experience consistent off-platform" },
  {
    stage: "On-time repayment",
    lever: "Clear statements & reminders ahead of due dates",
  },
];

const mariBankValueProps = [
  {
    title: "Unconditional savings",
    body: "No salary credit required, no minimum balance.",
  },
  {
    title: "No-frills credit card",
    body: "Easy-to-calculate cashback, no cap, no minimum spend.",
  },
  {
    title: "Low-fee investing",
    body: "[To verify: wording must match MAS advertising guidelines]",
  },
];

const mariBankSteps = [
  {
    stage: "Secondary bank",
    status: "Parks spare cash, enjoys Shopee perks",
    milestone: "Account opening, first deposit, first cross-sell",
  },
  {
    stage: "First choice",
    status: "Picks MariBank first for spending or investing",
    milestone: "Card becomes a daily driver, recurring investing starts",
  },
  {
    stage: "Primary bank",
    status: "Income and daily spend both run through MariBank",
    milestone: "Salary credit, GIRO, rising average balance",
  },
];

const measurementTree = [
  {
    branch: "Ecosystem",
    metric: "Products per household, cross-product retention",
    design: "Cross-sell paths, home-page distribution",
  },
  {
    branch: "ShopeePay",
    metric: "Payment penetration, cross-sell conversion",
    design: "Payment flow, landing pages",
  },
  {
    branch: "SPayLater",
    metric: "First-use conversion, on-time repayment",
    design: "Checkout presentation, repayment flow",
  },
  {
    branch: "Digital Bank",
    metric: "Deposit balance, % salary credit",
    design: "Onboarding flow, home information architecture",
  },
  {
    branch: "Brand",
    metric: "Brand awareness, % acquisition outside Shopee",
    design: "Brand system & marketing assets",
  },
];

const tocSections = [
  { id: "business-context", label: "Business context" },
  { id: "our-thesis", label: "Our view on fintech" },
  { id: "who-we-serve", label: "Who we serve" },
  { id: "principles", label: "Experience principles" },
  { id: "ecosystem-map", label: "Ecosystem map" },
  { id: "phases-markets", label: "Phases & markets" },
  { id: "shopeepay", label: "ShopeePay" },
  { id: "spaylater", label: "SPayLater" },
  { id: "maribank", label: "MariBank" },
  { id: "insurance-seller", label: "Insurance & seller services" },
  { id: "ai-stance", label: "AI in the experience" },
  { id: "measuring-impact", label: "Measuring impact" },
];
---

<BaseLayout
  title="Monee Ecosystem & Product Design Strategy — Lin Hongyu"
  description="Defining each product's ecosystem role, experience principles, and design levers as Monee moves from a financial matrix inside Shopee to an independent financial ecosystem."
>
  <!-- S-01: Hero -->
  <section class="section case-hero">
    <div class="wrap">
      <a class="back" href="/project">&larr; Back to Work</a>
      <p class="eyebrow eyebrow--accent">Strategy</p>
      <h1>Monee Ecosystem &amp; Product Design Strategy</h1>
      <p class="case-subtitle">
        Starting from where the business is today, defining each
        product's role in the ecosystem, its experience principles,
        and its design levers — so design and business move in the
        same direction.
      </p>
      <p class="case-byline">Head of Design&ensp;|&ensp;2021–Present</p>

      <!-- Ecosystem overview diagram: center "Monee", five product
           nodes orbiting it, outer arc labeled "Shopee" — the
           ecosystem grew out of Shopee and now extends beyond it.
           Visual cover only; detail lives in #ecosystem-map below. -->
      <div class="eco-hero-diagram" role="img" aria-label="Monee sits at the center of five products — ShopeePay, SPayLater, MariBank/SeaBank, Mari Invest, and Insurance — inside an outer arc labeled Shopee, showing the ecosystem growing out of Shopee and extending beyond it.">
        <svg viewBox="0 0 800 420" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M 60 340 A 370 370 0 0 1 740 340"
            fill="none"
            stroke="var(--color-line)"
            stroke-width="2"
            stroke-dasharray="4 8"
          />
          <text x="400" y="50" text-anchor="middle" class="eco-hero-arc-label">Shopee</text>
          <g class="eco-hero-spokes">
            <line x1="400" y1="230" x2="400" y2="120" />
            <line x1="400" y1="230" x2="240" y2="300" />
            <line x1="400" y1="230" x2="320" y2="340" />
            <line x1="400" y1="230" x2="480" y2="340" />
            <line x1="400" y1="230" x2="560" y2="300" />
          </g>
          <circle cx="400" cy="230" r="58" class="eco-hero-center" />
          <text x="400" y="236" text-anchor="middle" class="eco-hero-center-label">Monee</text>

          <g>
            <circle cx="400" cy="120" r="40" class="eco-hero-node" />
            <text x="400" y="124" text-anchor="middle" class="eco-hero-node-label">ShopeePay</text>
          </g>
          <g>
            <circle cx="240" cy="300" r="40" class="eco-hero-node" />
            <text x="240" y="298" text-anchor="middle" class="eco-hero-node-label">SPayLater</text>
            <text x="240" y="312" text-anchor="middle" class="eco-hero-node-label">&amp; Credit</text>
          </g>
          <g>
            <circle cx="320" cy="340" r="40" class="eco-hero-node" />
            <text x="320" y="338" text-anchor="middle" class="eco-hero-node-label">MariBank /</text>
            <text x="320" y="352" text-anchor="middle" class="eco-hero-node-label">SeaBank</text>
          </g>
          <g>
            <circle cx="480" cy="340" r="40" class="eco-hero-node" />
            <text x="480" y="344" text-anchor="middle" class="eco-hero-node-label">Mari Invest</text>
          </g>
          <g>
            <circle cx="560" cy="300" r="40" class="eco-hero-node" />
            <text x="560" y="304" text-anchor="middle" class="eco-hero-node-label">Insurance</text>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <!-- S-02: Overview -->
  <section class="section case-overview">
    <div class="wrap">
      <p class="case-intro">
        Monee is moving from a financial matrix inside Shopee to an
        independent financial ecosystem. That shift defines three
        priorities for design strategy.
      </p>
      <div class="card-row">
        {
          overviewCards.map((card) => (
            <div class="numbered-card">
              <p class="numbered-card-n">{card.n}</p>
              <p class="numbered-card-title">{card.title}</p>
              <p class="numbered-card-body">{card.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Body chapters: sticky TOC (desktop) / dropdown (mobile) -->
  <section class="section case-body">
    <div class="wrap case-body-grid">
      <nav class="case-toc" aria-label="Case study sections">
        <p class="case-toc-label">On this page</p>
        <ul>
          {
            tocSections.map((s) => (
              <li>
                <a href={`#${s.id}`} data-toc-link={s.id}>
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <select class="case-toc-mobile" aria-label="Jump to section">
        <option value="">On this page…</option>
        {
          tocSections.map((s) => (
            <option value={`#${s.id}`}>{s.label}</option>
          ))
        }
      </select>

      <div class="case-chapters">
        <!-- S-03: Business context -->
        <div class="case-chapter" id="business-context">
          <h2>Business context</h2>
          <div class="context-grid">
            <div class="context-diagram" role="img" aria-label="Sea Limited branches into Garena (gaming), Shopee (e-commerce), and Monee (digital financial services, highlighted).">
              <div class="context-root">Sea Limited</div>
              <div class="context-branches">
                <div class="context-branch">Garena<span>Gaming</span></div>
                <div class="context-branch">Shopee<span>E-commerce</span></div>
                <div class="context-branch context-branch--active">Monee<span>Digital financial services</span></div>
              </div>
            </div>
            <div class="stat-grid">
              {
                statCards.map((s) => (
                  <div class="stat-card">
                    <p class="stat-value">{s.value}</p>
                    <p class="stat-label">{s.label}</p>
                  </div>
                ))
              }
            </div>
          </div>
          <p class="source-note">
            Source: Sea Limited Q2 2026 results. Update with the
            latest figures before launch.
          </p>
        </div>

        <!-- S-04: Our view on fintech -->
        <div class="case-chapter" id="our-thesis">
          <h2>Our view on fintech</h2>
          <div class="compare-two">
            <div class="compare-col compare-col--muted">
              <p class="compare-title">Traditional finance mindset</p>
              <p class="compare-question">"What can we offer?"</p>
              <p class="compare-arrow">Product &rarr; User</p>
            </div>
            <div class="compare-col compare-col--accent">
              <p class="compare-title">Our mindset</p>
              <p class="compare-question">"What do specific users need?"</p>
              <p class="compare-arrow">User need &rarr; Product</p>
            </div>
          </div>
          <p class="chapter-conclusion">
            Real fintech uses digital platforms to design around
            specific user needs, delivering simple, trustworthy
            experiences.
          </p>
        </div>

        <!-- S-05: Who we serve -->
        <div class="case-chapter" id="who-we-serve">
          <h2>Who we serve</h2>
          <div class="card-row">
            <div class="user-card">
              <p class="user-card-title">The financially underserved</p>
              <p class="user-card-markets">
                Indonesia, Philippines, Vietnam, Brazil
              </p>
              <p class="user-card-body">
                Few assets, limited financial literacy — often get
                their first line of credit and first account through
                Shopee.
              </p>
              <p class="user-card-focus">
                Design focus: lower the barrier to understanding, earn
                first-time trust.
              </p>
            </div>
            <div class="user-card">
              <p class="user-card-title">
                Overlooked by experience and value
              </p>
              <p class="user-card-markets">
                Urban users in Singapore, Malaysia, Thailand
              </p>
              <p class="user-card-body">
                Already banked, but excluded by high thresholds,
                bundling, and cold experiences.
              </p>
              <p class="user-card-focus">
                Design focus: win them over from traditional banks
                with unconditional, transparent value.
              </p>
            </div>
          </div>
          <div class="path-diagram">
            <span>Few assets, little financial knowledge</span>
            <span class="path-diagram-arrow">
              the direction Monee grows with you &rarr;
            </span>
            <span>More assets, without needing to become a finance expert</span>
          </div>
          <p class="chapter-note">
            Shared trait: young and middle-aged internet users,
            price-sensitive, value-for-money. We compete off-axis from
            traditional banks and brokerages.
          </p>
        </div>

        <!-- S-06: Experience principles -->
        <div class="case-chapter" id="principles">
          <h2>Experience principles</h2>
          <div class="principle-list">
            {
              principles.map((p) => (
                <div class="principle-row">
                  <span class="principle-n">{p.n}</span>
                  <div>
                    <p class="principle-title">{p.title}</p>
                    <p class="principle-body">{p.body}</p>
                  </div>
                </div>
              ))
            }
            <p class="principle-order">
              &uarr; In a conflict, the principle higher on this list
              wins.
            </p>
          </div>
          <div class="callout">
            <p class="callout-title">Responsible rewarding</p>
            <p class="callout-body">
              Rewards should reinforce long-term positive behavior —
              saving, paying on time — not manufacture borrowing
              beyond repayment capacity.
            </p>
          </div>
        </div>

        <!-- S-07: Ecosystem map (interactive) -->
        <div class="case-chapter" id="ecosystem-map">
          <h2>Monee ecosystem map</h2>
          <p class="chapter-lead">
            Hover (or tap) a product for its ecosystem role and core
            metrics.
          </p>
          <div class="eco-map">
            <div class="eco-map-col eco-map-col--source">
              <p class="eco-map-col-label">Traffic sources</p>
              <p>Inside Shopee</p>
              <p>Outside Shopee</p>
            </div>
            <div class="eco-map-col eco-map-col--nodes">
              {
                ecosystemNodes.map((node) => (
                  <button type="button" class="eco-node">
                    <span class="eco-node-name">{node.name}</span>
                    <span class="eco-node-detail">
                      <span class="eco-node-detail-inner">
                        <span class="eco-node-role">{node.role}</span>
                        <span class="eco-node-metrics">{node.metrics}</span>
                      </span>
                    </span>
                  </button>
                ))
              }
            </div>
            <div class="eco-map-col eco-map-col--value">
              <p class="eco-map-col-label">Value captured</p>
              <p>Revenue</p>
              <p>Deposits</p>
              <p>Assets</p>
              <p>Loyalty</p>
            </div>
          </div>
          <p class="chapter-note">
            Cross-sell: ShopeePay &rarr; SPayLater, MariBank,
            Insurance. MariBank &rarr; Mari Invest, Credit Card.
          </p>
        </div>

        <!-- S-08: Phases & markets -->
        <div class="case-chapter" id="phases-markets">
          <h2>Business phases &amp; market segmentation</h2>
          <div class="phase-timeline">
            {
              phases.map((p, i) => (
                <>
                  <div class="phase-step">
                    <p class="phase-tag">{p.tag}</p>
                    <p class="phase-title">{p.title}</p>
                  </div>
                  {i === 1 && <div class="phase-marker">We are here</div>}
                </>
              ))
            }
          </div>
          <div class="market-table">
            {
              marketRows.map((row) => (
                <div class="market-row">
                  <p class="market-group">{row.group}</p>
                  <p class="market-markets">{row.markets}</p>
                  <p class="market-vehicle">{row.vehicle}</p>
                  <p class="market-focus">{row.focus}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- S-09: ShopeePay -->
        <div class="case-chapter" id="shopeepay">
          <h2>ShopeePay: traffic gateway</h2>
          <p class="chapter-lead">
            Captures Shopee's traffic and distributes it to the rest
            of the portfolio.
          </p>
          <div class="funnel">
            {
              shopeePayFunnel.map((step) => (
                <div class="funnel-step">
                  <p class="funnel-stage">{step.stage}</p>
                  <p class="funnel-body">{step.body}</p>
                </div>
              ))
            }
          </div>
          <div class="product-shots">
            <PlaceholderImage ratio="9/19" radius="24px" label="Payment page — funding source switch" />
            <PlaceholderImage ratio="9/19" radius="24px" label="Payment success — cross-sell slot" />
            <PlaceholderImage ratio="9/19" radius="24px" label="ShopeePay home" />
          </div>
          <div class="callout">
            <p class="callout-title">Don't interrupt the transaction</p>
            <p class="callout-body">
              Cross-sell after payment completes and on the home
              screen — never inside the payment flow itself.
            </p>
          </div>
        </div>

        <!-- S-10: SPayLater -->
        <div class="case-chapter" id="spaylater">
          <h2>SPayLater: revenue engine</h2>
          <p class="chapter-lead">
            Monee's largest revenue source, and most users' first
            touchpoint with Monee credit.
          </p>
          <div class="lifecycle-ring">
            {
              sPayLaterLifecycle.map((step) => (
                <div class="lifecycle-step">
                  <p class="lifecycle-stage">{step.stage}</p>
                  <p class="lifecycle-lever">{step.lever}</p>
                </div>
              ))
            }
          </div>
          <div class="stat-card stat-card--inline">
            <p class="stat-value">~10%</p>
            <p class="stat-label">
              SPayLater's share of Shopee GMV in Brazil, below mature
              markets.
            </p>
          </div>
          <div class="product-shots">
            <PlaceholderImage ratio="9/19" radius="24px" label="Checkout — installment picker" />
            <PlaceholderImage ratio="9/19" radius="24px" label="Statement page" />
            <PlaceholderImage ratio="9/19" radius="24px" label="Repayment reminder" />
          </div>
          <div class="callout">
            <p class="callout-title">Growth defers to risk</p>
            <p class="callout-body">
              In new markets, make sure users understand fees and
              repayment responsibility before chasing penetration.
            </p>
          </div>
        </div>

        <!-- S-11: MariBank -->
        <div class="case-chapter" id="maribank">
          <h2>MariBank: long-term growth engine</h2>
          <p class="chapter-lead">
            Captures traffic from ShopeePay and outside channels, and
            converts it into high-value, loyal users.
          </p>
          <div class="challenge-row">
            <div class="stat-card stat-card--inline">
              <p class="stat-value">3+</p>
              <p class="stat-label">
                Average number of banking relationships per Singapore
                user
              </p>
            </div>
            <p class="challenge-body">
              Traditional banks lock users in with bundling; banking
              products look alike. Switching a primary account is
              costly. Our wedge is experience: simple and clear.
            </p>
          </div>
          <div class="card-row card-row--three">
            {
              mariBankValueProps.map((v) => (
                <div class="value-card">
                  <p class="value-card-title">{v.title}</p>
                  <p class="value-card-body">{v.body}</p>
                </div>
              ))
            }
          </div>
          <div class="steps-diagram">
            {
              mariBankSteps.map((s) => (
                <div class="steps-step">
                  <p class="steps-stage">{s.stage}</p>
                  <p class="steps-status">{s.status}</p>
                  <p class="steps-milestone">{s.milestone}</p>
                </div>
              ))
            }
          </div>
          <div class="cross-sell-paths">
            <div class="cross-sell-path">
              <p class="cross-sell-title">Investing-minded</p>
              <p class="cross-sell-flow">
                Shopee high-interest perk or external channel &rarr;
                Savings &rarr; Investing &amp; trading
              </p>
            </div>
            <div class="cross-sell-path">
              <p class="cross-sell-title">Spending-minded</p>
              <p class="cross-sell-flow">
                Shopee voucher or external channel &rarr; Savings
                &rarr; Payments &amp; credit card
              </p>
            </div>
            <p class="chapter-note">
              Touchpoints: home screen, mission center, push. Clear
              intent gets a direct entry point; unclear intent gets
              loosely matched via the mission center.
            </p>
          </div>
          <div class="card-row">
            <div class="strategy-card">
              <p class="strategy-card-title">Investing-minded</p>
              <p class="strategy-card-body">
                No fund supermarket or rankings — present by asset
                class and risk/return to avoid over-choice.
              </p>
              <a class="strategy-card-link" href="/work/marinvest">
                Mari Invest case &rarr;
              </a>
            </div>
            <div class="strategy-card">
              <p class="strategy-card-title">Spending-minded</p>
              <p class="strategy-card-body">
                Rewards that are easy to calculate, flows kept short —
                one job per screen.
              </p>
              <a class="strategy-card-link" href="/work/mari-credit-card">
                Mari Credit Card case &rarr;
              </a>
            </div>
          </div>
          <div class="product-shots">
            <PlaceholderImage ratio="9/19" radius="24px" label="MariBank home" />
            <PlaceholderImage ratio="9/19" radius="24px" label="Product entry points" />
          </div>
        </div>

        <!-- S-12: Insurance & seller services -->
        <div class="case-chapter" id="insurance-seller">
          <h2>Insurance &amp; seller services</h2>
          <div class="card-row">
            <div class="simple-card">
              <p class="simple-card-title">Insurance</p>
              <p class="simple-card-body">
                Embed product protection in transaction moments; spell
                out coverage and price at checkout; keep claims simple
                and trustworthy. [To add: specific project]
              </p>
            </div>
            <div class="simple-card">
